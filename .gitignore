# 环境文件
.env
.env.*
# 但模板必须入库（供新部署复制）
!.env.example

# 敏感文件（实际敏感的配置）
**/env.json

# 图床 Token 明细文件（一行一个真实 Token），仅本地保存，禁止入库
tokens.txt
toekns.txt

# 抖音评论沙箱的登录态/票据文件（真实账号敏感信息，不入库）
/scripts/douyin_comment_publish/cookie.txt
/scripts/douyin_comment_publish/ms_token.txt
/scripts/douyin_comment_publish/sec_headers.json

# 红果离线签名服务的运行物：unidbg 胖 jar（约 31MB）与 metasec 原生库/证书。
# 属第三方二进制，按 scripts/hongguo_sign/start_sign_service.bat 顶部说明单独获取，不入库。
# 注：内置裁剪版 JRE（jre/，约 32MB）已入库——它是「免装 Java 即可运行」的关键，
# 用 jlink 生成，重建命令见 start_sign_service.bat 顶部说明。
/scripts/hongguo_sign/sign/unidbg-sign.jar
/scripts/hongguo_sign/capture/

# 日志文件
*.log
logs/

# 爬虫运行时产物（结果/缓存/待处理队列，随抓取不断变化）
SpiderServices/*/output/

# 数据库文件
*.db
*.sqlite3
# SQLite 开启 WAL 后的伴生文件（WAL 见 API/apps.py 的 _configure_sqlite）
*.sqlite3-wal
*.sqlite3-shm

# 媒体文件:仅忽略 media/uploads/ 下的用户上传内容,允许提交 API/apis/uploads/ 代码目录
