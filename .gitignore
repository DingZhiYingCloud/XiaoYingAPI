# 系统文件
.DS_Store
Thumbs.db

# 依赖文件
node_modules/

TuLianVenv/

unpackage/

# migrations 目录随代码入库（A-05 整改）：模型变更在本地 makemigrations 生成迁移并提交，
# 线上仅执行 migrate，禁止线上 makemigrations（会与本地迁移集不一致导致漂移）
# （__pycache__ 已由上方通用规则忽略）

Test/

# collectstatic 产物目录（整个 STATIC_ROOT 均为部署时重新生成的产物，禁止入库）
# 源文件统一放在 API/static/；历史误提交的 static/js、static/css 等副本已取消跟踪。
# 注意：collectstatic 默认按 mtime 判断“是否修改”，仓库 checkout 的文件时间戳相同会被
# 误判为未修改而跳过更新，部署时请使用：python manage.py collectstatic --noinput --clear
/static/

# 电影爬虫运行时缓存（cache/movies/<线路>/ 下的 .djcache 由代码生成，随抓取变化，不入库）
/cache/

# daisyUI 前端编译工具：Tailwind 独立可执行文件(约 107MB，不入库；按官方文档重新下载即可)
# 下载地址: https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-windows-x64.exe
# 通配所有目录（源目录 API/static/css 与 collectstatic 产物目录 static/css 各有一份副本）
tailwindcss.exe