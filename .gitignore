# 环境文件
.env
.env.*

# 敏感文件（实际敏感的配置）
**/env.json

# 日志文件
*.log
logs/

# 爬虫运行时产物（结果/缓存/待处理队列，随抓取不断变化）
SpiderServices/*/output/

# 数据库文件
*.db
*.sqlite3

# 媒体文件:仅忽略 media/uploads/ 下的用户上传内容,允许提交 API/apis/uploads/ 代码目录
/media/uploads/

# 系统文件
.DS_Store
Thumbs.db

# 依赖文件
node_modules/

TuLianVenv/

unpackage/

# migrations 目录：保留 __init__.py（Python 包必需，目录随代码上传），迁移文件不入库
# 迁移文件由线上 makemigrations 生成，避免与本地冲突；数据迁移（如分类树生成）
# 无法自动执行时，使用管理命令补充（如 python manage.py rebuild_category_tree）
**/migrations/*
!**/migrations/__init__.py

Test/

# collectstatic 产物目录（simpleui 等静态文件收集到此，部署时重新生成）
/static/admin/
/static/API/