# ==================== 官网文案更新：额度计费说明（首页 / 文档中心 / 接入向导） ====================
msgid "按次计费 · 点数余额"
msgstr "按次計費 · 點數餘額"

msgid "调用按次消耗项目额度（点数），单价以文档页标价为准。"
msgstr "調用按次消耗項目額度（點數），單價以文檔頁標價為準。"

msgid "每个端点标注单价"
msgstr "每個端點標註單價"

msgid "使用用户名、邮箱或手机号注册小影API账号，注册与登录均免费。"
msgstr "使用用戶名、郵箱或手機號註冊小影API賬號，註冊與登錄均免費。"

msgid "创建接入项目"
msgstr "創建接入項目"

msgid "登录后在「我的项目」自助创建，立即获得专属 APPID 与 APPSECRET，创建项目免费。"
msgstr "登錄後在「我的項目」自助創建，立即獲得專屬 APPID 與 APPSECRET，創建項目免費。"

msgid "充值额度并调用"
msgstr "充值額度並調用"

msgid "为项目充值点数后即可调用（新项目默认 0 额度）；成功后按次扣点、失败不扣，统一 <code class=\"font-mono text-xs\">{ code, msg, data }</code> 响应。"
msgstr "為項目充值點數後即可調用（新項目默認 0 額度）；成功後按次扣點、失敗不扣，統一 <code class=\"font-mono text-xs\">{ code, msg, data }</code> 響應。"

msgid "调用接口要收费吗？额度怎么算？"
msgstr "調用接口要收費嗎？額度怎麼算？"

msgid "注册、登录、创建项目与浏览文档均免费。调用接口按次消耗项目额度（点数），单价以接口文档页标价为准（未单独配置的服务默认 1 点/次）；只有调用成功才扣点，失败不扣。新建项目默认 0 额度，额度不足时无法调用接口（开放接口除外），请联系管理员充值。"
msgstr "註冊、登錄、創建項目與瀏覽文檔均免費。調用接口按次消耗項目額度（點數），單價以接口文檔頁標價為準（未單獨配置的服務默認 1 點/次）；只有調用成功才扣點，失敗不扣。新建項目默認 0 額度，額度不足時無法調用接口（開放接口除外），請聯繫管理員充值。"

msgid "登录后在「我的项目」页自助创建接入项目，创建后即可看到 APPID / APPSECRET，创建项目免费。APPSECRET 请务必保存在你的服务端，严禁写入前端代码或提交到仓库。"
msgstr "登錄後在「我的項目」頁自助創建接入項目，創建後即可看到 APPID / APPSECRET，創建項目免費。APPSECRET 請務必保存在你的服務端，嚴禁寫入前端代碼或提交到倉庫。"

msgid "小影API 是一个通用 API 聚合服务平台，聚合音乐、视频解析、AI、代理IP、验证码、短信、邮箱、用户中心等 %(n)s 类服务能力，统一签名认证与标准 JSON 响应，注册免费、调用按次消耗项目额度（点数）。"
msgstr "小影API 是一個通用 API 聚合服務平臺，聚合音樂、視頻解析、AI、代理IP、驗證碼、短信、郵箱、用戶中心等 %(n)s 類服務能力，統一簽名認證與標準 JSON 響應，註冊免費、調用按次消耗項目額度（點數）。"

msgid "登录后在「我的项目」自助创建，立即获得专属 APPID 与 APPSECRET（新建项目默认 0 额度，创建免费）。"
msgstr "登錄後在「我的項目」自助創建，立即獲得專屬 APPID 與 APPSECRET（新建項目默認 0 額度，創建免費）。"

msgid "充值额度并接入生产"
msgstr "充值額度並接入生產"

msgid "为项目充值点数后即可调用（成功按次扣点、失败不扣）；在上线前于服务端实现 HMAC-SHA256 签名，密钥放进环境变量，绝不进前端。"
msgstr "為項目充值點數後即可調用（成功按次扣點、失敗不扣）；在上線前於服務端實現 HMAC-SHA256 簽名，密鑰放進環境變量，絕不進前端。"

msgid "② 创建接入项目"
msgstr "② 創建接入項目"

msgid "登录后在「我的项目」自助创建项目；创建后"
msgstr "登錄後在「我的項目」自助創建項目；創建後"

msgid "APPID 是公开标识；APPSECRET 是签名密钥，只应保存在你的服务端。泄露可在「我的项目」详情页一键重置。"
msgstr "APPID 是公開標識；APPSECRET 是簽名密鑰，只應保存在你的服務端。泄露可在「我的項目」詳情頁一鍵重置。"

msgid "④ 充值额度"
msgstr "④ 充值額度"

msgid "新建项目默认 0 额度，调用接口前需联系管理员为项目充值点数；成功调用按次扣点，失败不扣。"
msgstr "新建項目默認 0 額度，調用接口前需聯繫管理員為項目充值點數；成功調用按次扣點，失敗不扣。"

msgid "调用接口要额度吗？怎么计费？"
msgstr "調用接口要額度嗎？怎麼計費？"

msgid "注册、登录、创建项目与浏览文档均免费。调用接口按次消耗项目额度（点数），单价以接口文档页标价为准（未单独配置的服务默认 1 点/次）；只有调用成功（业务码 10000）才扣点，失败不扣。新建项目默认 0 额度，调用前需联系管理员充值；余额不足时接口返回 30012，开放接口（免签名）不受额度限制。"
msgstr "註冊、登錄、創建項目與瀏覽文檔均免費。調用接口按次消耗項目額度（點數），單價以接口文檔頁標價為準（未單獨配置的服務默認 1 點/次）；只有調用成功（業務碼 10000）才扣點，失敗不扣。新建項目默認 0 額度，調用前需聯繫管理員充值；餘額不足時接口返回 30012，開放接口（免簽名）不受額度限制。"

msgid "10000=成功；20001/20002/20003=参数缺失/格式错误/值非法；20011=签名或认证失败；20040=触发频率限制（如登录连续失败被临时锁定）；30012=额度不足（项目余额低于本次调用单价，请充值）；40001=外部服务调用失败（请稍后重试或核对被调用的第三方资源）。"
msgstr "10000=成功；20001/20002/20003=參數缺失/格式錯誤/值非法；20011=簽名或認證失敗；20040=觸發頻率限制（如登錄連續失敗被臨時鎖定）；30012=額度不足（項目餘額低於本次調用單價，請充值）；40001=外部服務調用失敗（請稍後重試或核對被調用的第三方資源）。"

msgid "在「我的项目」详情页点「重置密钥」即可，旧密钥立即失效；重置后所有已接入的调用需改用新密钥。"
msgstr "在「我的項目」詳情頁點「重置密鑰」即可，舊密鑰立即失效；重置後所有已接入的調用需改用新密鑰。"

