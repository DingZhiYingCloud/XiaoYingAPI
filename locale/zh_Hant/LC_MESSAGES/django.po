# ==================== 超级管理控制台 · 服务策略（服务 / 线路 / 端点三级继承） ====================
msgid "服务策略"
msgstr "服務策略"

msgid "服务策略 - 超级管理员 - 小影API"
msgstr "服務策略 - 超級管理員 - 小影API"

msgid "超级管理员,服务策略,状态,认证模式,项目白名单,三级继承"
msgstr "超級管理員,服務策略,狀態,認證模式,項目白名單,三級繼承"

msgid "小影API 超级管理员：按服务 / 线路 / 端点三级配置认证模式与对外状态，逐级继承。"
msgstr "小影API 超級管理員：按服務 / 線路 / 端點三級配置認證模式與對外狀態，逐級繼承。"

msgid "共 %(total)s 条策略；服务 / 线路 / 端点三级逐级继承，改动后立即对接口鉴权生效，无需重启。"
msgstr "共 %(total)s 條策略；服務 / 線路 / 端點三級逐級繼承，改動後立即對接口鑑權生效，無需重啟。"

msgid "逐级继承：服务 → 线路 → 端点，每一级都可单独设状态 / 认证模式 / 项目范围 / 文档可见性 / 使用范围；设为「跟随上级」则向上一级取，最终兜底为「正常 + 需要签名 + 不限项目 + 文档展示 + 正常」。"
msgstr "逐級繼承：服務 → 線路 → 端點，每一級都可單獨設狀態 / 認證模式 / 項目範圍 / 文檔可見性 / 使用範圍；設為「跟隨上級」則向上一級取，最終兜底為「正常 + 需要簽名 + 不限項目 + 文檔展示 + 正常」。"

msgid "维护态：生效状态为「维护中」时，命中路径的 /api/ 请求统一返回 30004「服务维护中」，且不做签名校验（匿名同样收到）。"
msgstr "維護態：生效狀態為「維護中」時，命中路徑的 /api/ 請求統一返回 30004「服務維護中」，且不做簽名校驗（匿名同樣收到）。"

msgid "开发中 / 已下线只作前台展示标记，不拦截请求（便于排障与联调）。"
msgstr "開發中 / 已下線只作前臺展示標記，不攔截請求（便於排障與聯調）。"

msgid "项目白名单：仅在生效认证模式为「需要签名」时生效——签名通过后若当前项目不在名单内，返回 20020「无权限」；开放模式不校验签名，拿不到调用项目。"
msgstr "項目白名單：僅在生效認證模式為「需要簽名」時生效——簽名通過後若當前項目不在名單內，返回 20020「無權限」；開放模式不校驗簽名，拿不到調用項目。"

msgid "文档可见性：生效值「文档隐藏」的路径不会出现在官网文档中心与在线调试中（后台内部接口用）。"
msgstr "文檔可見性：生效值「文檔隱藏」的路徑不會出現在官網文檔中心與在線調試中（後臺內部接口用）。"

msgid "使用范围：生效值「仅专属管理员」的路径仅供后台内部使用，对外调用一律返回 20020「无权限」（不区分是否带签名）。"
msgstr "使用範圍：生效值「僅專屬管理員」的路徑僅供後臺內部使用，對外調用一律返回 20020「無權限」（不區分是否帶簽名）。"

msgid "未命中任何策略的 /api/ 路径按全局默认「需要签名」处理（fail-closed）。"
msgstr "未命中任何策略的 /api/ 路徑按全局默認「需要簽名」處理（fail-closed）。"

