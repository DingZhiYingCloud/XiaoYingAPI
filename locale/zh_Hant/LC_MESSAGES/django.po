msgstr "兩個端點都免簽名（服務策略裡配成 open）：ticket 的憑證是調用方本來就持有的用戶 UAC Token，contacts 是公開信息。提交、查看與回復都不走 /api/，而是在 /feedback/<app_id>/ 反饋頁上由本站直接處理。"

msgid "换取反馈页一次性票据"
msgstr "換取反饋頁一次性票據"

msgid "用用户的 UAC Token 换一张一次性票据（5 分钟过期），子项目把它拼进反馈页地址即可让用户以登录身份提交反馈。"
msgstr "用用戶的 UAC Token 換一張一次性票據（5 分鐘過期），子項目把它拼進反饋頁地址即可讓用戶以登錄身份提交反饋。"

msgid "用户登录 Token"
msgstr "用戶登錄 Token"

msgid "用户在**你项目下**的 UAC Token（Token 绑定项目，跨项目的 Token 无效）"
msgstr "用戶在**你項目下**的 UAC Token（Token 綁定項目，跨項目的 Token 無效）"

msgid "返回 data.ticket / data.expire_in / data.app_id / data.app_name。"
msgstr "返回 data.ticket / data.expire_in / data.app_id / data.app_name。"

msgid "票据一次性且 5 分钟过期：用完或过期即废，重复使用会被忽略（反馈页按游客处理）。"
msgstr "票據一次性且 5 分鐘過期：用完或過期即廢，重複使用會被忽略（反饋頁按遊客處理）。"

