msgstr "視頻 ID"

msgid "视频解析"
msgstr "視頻解析"

msgid "解析抖音内容"
msgstr "解析抖音內容"

msgid "解析抖音视频或图文，返回无水印地址等信息。"
msgstr "解析抖音視頻或圖文，返回無水印地址等信息。"

msgid "评论发布"
msgstr "評論發布"

msgid "评论接口风控较严，建议低频调用并对失败做退避重试，避免短时间内对同一视频重复提交。"
msgstr "評論接口風控較嚴，建議低頻調用並對失敗做退避重試，避免短時間內對同一視頻重複提交。"

