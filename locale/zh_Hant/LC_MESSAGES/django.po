# ==================== API 文档内容 · 用户中心 ====================
msgid "email / phone 至少提供一个；两步注册时 data.need_verify=true，需再调 verify/email 或 verify/phone 校验通过后才创建账号。"
msgstr "email / phone 至少提供一個；兩步註冊時 data.need_verify=true，需再調 verify/email 或 verify/phone 校驗通過後才創建賬號。"

msgid "不带 code 时必填：account/email/phone 任一标识 + 密码"
msgstr "不帶 code 時必填：account/email/phone 任一標識 + 密碼"

msgid "仅支持已绑定邮箱/手机号的账号；纯用户名账号没有可验证通道，无法自助重置。"
msgstr "僅支持已綁定郵箱/手機號的賬號；純用戶名賬號沒有可驗證通道，無法自助重置。"

msgid "仅需项目签名参数，无需业务参数。"
msgstr "僅需項目簽名參數，無需業務參數。"

msgid "供子项目确认用户身份：校验 token 有效性。"
msgstr "供子項目確認用戶身份：校驗 token 有效性。"

msgid "删除当前项目下该 Token。"
msgstr "刪除當前項目下該 Token。"

msgid "发送两步注册的手机短信验证码（60 秒冷却）。"
msgstr "發送兩步註冊的手機短信驗證碼（60 秒冷卻）。"

msgid "发送注册短信"
msgstr "發送註冊短信"

msgid "发送登录验证码"
msgstr "發送登錄驗證碼"

msgid "发送重置密码验证码"
msgstr "發送重置密碼驗證碼"

msgid "只提供 username（即\"用户名+密码注册\"）已停用，返回 30001 业务规则限制。"
msgstr "只提供 username（即\"用戶名+密碼註冊\"）已停用，返回 30001 業務規則限制。"

msgid "可用注册/登录方式"
msgstr "可用註冊/登錄方式"

msgid "同一项目+凭证+IP 连续失败 5 次锁定 15 分钟（返回 20040）。"
msgstr "同一項目+憑證+IP 連續失敗 5 次鎖定 15 分鐘（返回 20040）。"

msgid "带 code 即走邮箱/手机号验证码登录（免密码）"
msgstr "帶 code 即走郵箱/手機號驗證碼登錄（免密碼）"

msgid "必填：用户在该项目下持有的登录 Token（login 成功返回）"
msgstr "必填：用戶在該項目下持有的登錄 Token（login 成功返回）"

msgid "密码登录的标识三选一：account / email / phone（邮箱与手机号需已注册）。"
msgstr "密碼登錄的標識三選一：account / email / phone（郵箱與手機號需已註冊）。"

msgid "忘记密码第一步：校验邮箱/手机号已注册后发码（60 秒冷却）。"
msgstr "忘記密碼第一步：校驗郵箱/手機號已註冊後發碼（60 秒冷卻）。"

msgid "忘记密码第二步：校验验证码通过后设置新密码。"
msgstr "忘記密碼第二步：校驗驗證碼通過後設置新密碼。"

