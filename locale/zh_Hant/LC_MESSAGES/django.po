msgstr "渠道標識，當前為 ezfp"

msgid "支付形态：qrcode=二维码内容 / jump=收银台地址"
msgstr "支付形態：qrcode=二維碼內容 / jump=收銀臺地址"

msgid "金额（元，两位小数）"
msgstr "金額（元，兩位小數）"

msgid "订单状态：pending 待支付 / paid 已支付 / partial_refunded 部分退款 / refunded 已退款 / failed 下单失败 / closed 已关闭"
msgstr "訂單狀態：pending 待支付 / paid 已支付 / partial_refunded 部分退款 / refunded 已退款 / failed 下單失敗 / closed 已關閉"

msgid "支付参数：pay_type=qrcode 时是二维码内容，jump 时是收银台地址"
msgstr "支付參數：pay_type=qrcode 時是二維碼內容，jump 時是收銀臺地址"

msgid "业务扩展参数，原样返回"
msgstr "業務擴展參數，原樣返回"

msgid "按商户订单号查询订单，并把平台最新状态同步回本站（已支付会补发货）。"
msgstr "按商戶訂單號查詢訂單，並把平臺最新狀態同步回本站（已支付會補發貨）。"

msgid "商户订单号"
msgstr "商戶訂單號"

msgid "必填。下单接口返回的 out_trade_no"
msgstr "必填。下單接口返回的 out_trade_no"

msgid "只能查**本调用方自己**下的单：订单按 APPID 归属隔离，别人的单一律返回「订单不存在」。"
msgstr "只能查**本調用方自己**下的單：訂單按 APPID 歸屬隔離，別人的單一律返回「訂單不存在」。"

msgid "查到平台已支付且本站订单还没推进时，本接口会**当场补发货**（按后台汇率给调用项目加点数），因此「回调没收到」也能靠轮询查单兜底。"
msgstr "查到平臺已支付且本站訂單還沒推進時，本接口會**當場補發貨**（按後臺匯率給調用項目加點數），因此「回調沒收到」也能靠輪詢查單兜底。"

msgid "已下单后建议每 3～5 秒查一次，直到 `paid=true` 或超时；不必高频轮询，平台侧订单状态不会瞬间多次跳变。"
msgstr "已下單後建議每 3～5 秒查一次，直到 `paid=true` 或超時；不必高頻輪詢，平臺側訂單狀態不會瞬間多次跳變。"

msgid "是否已支付（true 时订单已推进并发货）"
msgstr "是否已支付（true 時訂單已推進並發貨）"

msgid "订单退款"
msgstr "訂單退款"

msgid "对已支付的订单发起退款；`amount` 留空表示退回剩余可退金额。"
msgstr "對已支付的訂單發起退款；`amount` 留空表示退回剩餘可退金額。"

msgid "必填。要退款的订单号"
msgstr "必填。要退款的訂單號"

msgid "退款金额（元）"
msgstr "退款金額（元）"

msgid "留空=全额退剩余"
msgstr "留空=全額退剩餘"

msgid "选填。不得大于可退金额（订单金额 − 已退金额）"
msgstr "選填。不得大於可退金額（訂單金額 − 已退金額）"

msgid "只能退**本调用方自己**的订单。退款是否支持分笔、到账时长由支付平台与渠道决定，本接口只负责提交并把结果回写订单。"
msgstr "只能退**本調用方自己**的訂單。退款是否支持分筆、到賬時長由支付平臺與渠道決定，本接口只負責提交並把結果回寫訂單。"

msgid "退款成功后本站订单状态变为 `refunded`（部分退款为 `partial_refunded`），累计退款额记在 `refund_amount`。"
msgstr "退款成功後本站訂單狀態變為 `refunded`（部分退款為 `partial_refunded`），累計退款額記在 `refund_amount`。"

msgid "⚠️ **已充进调用项目点数的订单退款，点数不会自动扣回** ——需要人工核账时请联系本站管理员。"
msgstr "⚠️ **已充進調用項目點數的訂單退款，點數不會自動扣回** ——需要人工核賬時請聯繫本站管理員。"

msgid "累计已退款金额（元）"
msgstr "累計已退款金額（元）"
