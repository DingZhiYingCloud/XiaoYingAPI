# ==================== API 文档内容 · 抖音 ====================
msgid "5.89 dAT:/ ... https://v.douyin.com/xxxxx/ 复制此链接...\n或直接粘贴链接 / aweme_id"
msgstr "5.89 dAT:/ ... https://v.douyin.com/xxxxx/ 複製此鏈接...\n或直接粘貼鏈接 / aweme_id"

msgid "7622798120358923583"
msgstr "7622798120358923583"

msgid "一级纯文本评论内容"
msgstr "一級純文本評論內容"

msgid "两条线路均需项目签名。抖音的风控参数全部由服务端处理：视频解析走匿名 ttwid 加重试策略，评论发布在服务端补环境执行抖音官方 JS 生成所需签名，调用方既不需要浏览器，也不需要自行实现签名算法。"
msgstr "兩條線路均需項目簽名。抖音的風控參數全部由服務端處理：視頻解析走匿名 ttwid 加重試策略，評論發布在服務端補環境執行抖音官方 JS 生成所需簽名，調用方既不需要瀏覽器，也不需要自行實現簽名算法。"

msgid "发布抖音评论"
msgstr "發布抖音評論"

msgid "在指定视频下发布一条一级纯文本评论，返回评论 ID、内容与发布时间。"
msgstr "在指定視頻下發布一條一級純文本評論，返回評論 ID、內容與發布時間。"

msgid "在指定视频下发布一级纯文本评论，需携带真实抖音登录 Cookie。"
msgstr "在指定視頻下發布一級純文本評論，需攜帶真實抖音登錄 Cookie。"

msgid "必填：抖音登录 Cookie 完整字符串（含 sessionid 等）。仅透传给抖音，服务端不落盘；Cookie 失效会返回外部服务错误。"
msgstr "必填：抖音登錄 Cookie 完整字符串（含 sessionid 等）。僅透傳給抖音，服務端不落盤；Cookie 失效會返回外部服務錯誤。"

msgid "必填：支持三种输入 —— ①完整分享文本 ②链接（v.douyin.com 短链 或 www.douyin.com/video/xxx）③纯数字 aweme_id"
msgstr "必填：支持三種輸入 —— ①完整分享文本 ②鏈接（v.douyin.com 短鏈 或 www.douyin.com/video/xxx）③純數字 aweme_id"

msgid "必填：目标视频 ID，纯数字，取自视频页 URL 的 /video/<aweme_id> 部分。"
msgstr "必填：目標視頻 ID，純數字，取自視頻頁 URL 的 /video/<aweme_id> 部分。"

msgid "必填：评论内容。当前仅支持一级纯文本评论，不支持 @ / 话题 / 图片。"
msgstr "必填：評論內容。當前僅支持一級純文本評論，不支持 @ / 話題 / 圖片。"

msgid "把抖音分享内容解析为可直接下载的视频/图文数据。"
msgstr "把抖音分享內容解析為可直接下載的視頻/圖文數據。"

msgid "抖音"
msgstr "抖音"

msgid "抖音API,抖音视频解析,抖音去水印,抖音图文解析"
msgstr "抖音API,抖音視頻解析,抖音去水印,抖音圖文解析"

msgid "抖音分享文本"
msgstr "抖音分享文本"

