msgstr "成功返回 data={valid, user_id, account, username}。"

msgid "手机号+密码登录，或手机号+code 验证码登录"
msgstr "手機號+密碼登錄，或手機號+code 驗證碼登錄"

msgid "手机号两步验证"
msgstr "手機號兩步驗證"

