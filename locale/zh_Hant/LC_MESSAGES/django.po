msgstr "註冊（只支持郵箱 / 手機號）：提交郵箱或手機號 + 密碼走兩步註冊，先發驗證碼。"

msgid "浏览器打开邮件内激活链接，校验通过后创建账号并发放。"
msgstr "瀏覽器打開郵件內激活鏈接，校驗通過後創建賬號並發放。"

msgid "激活令牌"
msgstr "激活令牌"

msgid "用户中心API,统一认证,注册登录接口,Token验证"
msgstr "用戶中心API,統一認證,註冊登錄接口,Token驗證"

msgid "用户中心是一套统一账号系统（UAC）：所有接入项目共用一个全局用户池，用户在一个项目下注册的账号，在其它项目下同样可以登录，不必每个项目各建一套账号体系。"
msgstr "用戶中心是一套統一賬號系統（UAC）：所有接入項目共用一個全局用戶池，用戶在一個項目下註冊的賬號，在其它項目下同樣可以登錄，不必每個項目各建一套賬號體系。"

msgid "用户账号体系"
msgstr "用戶賬號體系"

msgid "登录态用 Token 承载，Token 绑定签发它的接入项目。注册仅支持邮箱或手机号，且为两步流程——先提交凭证发验证码，校验通过后才真正创建账号，可有效防止恶意批量注册；忘记密码同样走「先发码、再校验改密」，重置成功后会作废该用户的全部 Token。"
msgstr "登錄態用 Token 承載，Token 綁定簽發它的接入項目。註冊僅支持郵箱或手機號，且為兩步流程——先提交憑證發驗證碼，校驗通過後才真正創建賬號，可有效防止惡意批量註冊；忘記密碼同樣走「先發碼、再校驗改密」，重置成功後會作廢該用戶的全部 Token。"

msgid "登录：账号/邮箱/手机号+密码；或邮箱/手机号+验证码。成功返回绑定项目的 Token。"
msgstr "登錄：賬號/郵箱/手機號+密碼；或郵箱/手機號+驗證碼。成功返回綁定項目的 Token。"

msgid "统一账号中心（UAC）：全局用户池，多方式注册/登录、Token 签发与验证、两步注册邮箱/手机号校验。"
msgstr "統一賬號中心（UAC）：全局用戶池，多方式註冊/登錄、Token 簽發與驗證、兩步註冊郵箱/手機號校驗。"

msgid "统一账号池（Token 绑定接入项目）"
msgstr "統一賬號池（Token 綁定接入項目）"

msgid "账号"
msgstr "賬號"

msgid "账号+密码登录：系统发放的账号"
msgstr "賬號+密碼登錄：系統發放的賬號"

msgid "返回 HTML 结果页；在线调试会得到 HTML 原文，属正常。"
msgstr "返回 HTML 結果頁；在線調試會得到 HTML 原文，屬正常。"

msgid "返回 data={methods:[email,phone], username:false}；客户端先查此接口再渲染表单，username=false 表示\"用户名+密码注册\"已停用。"
msgstr "返回 data={methods:[email,phone], username:false}；客戶端先查此接口再渲染表單，username=false 表示\"用戶名+密碼註冊\"已停用。"

msgid "返回后台启用的注册/登录方式（公开，免签名）。"
msgstr "返回後臺啟用的註冊/登錄方式（公開，免簽名）。"

