msgid "短剧API,短剧接口,免费短剧API,红果短剧接口,短剧播放直链,短剧搜索接口"
msgstr "短劇API,短劇接口,免費短劇API,紅果短劇接口,短劇播放直鏈,短劇搜索接口"

msgid "短剧名"
msgstr "短劇名"

msgid "短剧服务聚合短剧站数据，提供榜单、分类、搜索、详情与播放直链等能力，按「榜单/分类 → 列表 → 详情 → 播放」的顺序即可搭起一个短剧站，搜索接口则支持按剧名关键词查剧。"
msgstr "短劇服務聚合短劇站數據，提供榜單、分類、搜索、詳情與播放直鏈等能力，按「榜單/分類 → 列表 → 詳情 → 播放」的順序即可搭起一個短劇站，搜索接口則支持按劇名關鍵詞查劇。"

msgid "短剧服务：提供短剧的榜单、分类、搜索、详情与播放直链能力，按「榜单/分类 → 列表 → 详情 → 播放」流程即可搭建短剧站。"
msgstr "短劇服務：提供短劇的榜單、分類、搜索、詳情與播放直鏈能力，按「榜單/分類 → 列表 → 詳情 → 播放」流程即可搭建短劇站。"

msgid "短剧聚合：热播榜单、分类、搜索、剧集详情（含全量集列表）与播放地址，全量集数均可播放（前 3 集为源站明链，第 4 集及以后由服务端取流并解密），按「榜单/分类 → 详情 → 播放」即可搭建短剧站。"
msgstr "短劇聚合：熱播榜單、分類、搜索、劇集詳情（含全量集列表）與播放地址，全量集數均可播放（前 3 集為源站明鏈，第 4 集及以後由服務端取流並解密），按「榜單/分類 → 詳情 → 播放」即可搭建短劇站。"

msgid "红果短剧"
msgstr "紅果短劇"

msgid "红果短剧（hongguoduanju.com）网页版"
msgstr "紅果短劇（hongguoduanju.com）網頁版"

msgid "获取剧集详情与全量集列表。"
msgstr "獲取劇集詳情與全量集列表。"

msgid "获取分类树（一级 -> 二级题材）。"
msgstr "獲取分類樹（一級 -> 二級題材）。"

msgid "获取指定集的播放地址。"
msgstr "獲取指定集的播放地址。"

msgid "获取指定集的播放地址（网页可直接播放）。"
msgstr "獲取指定集的播放地址（網頁可直接播放）。"

msgid "网页直出流"
msgstr "網頁直出流"

msgid "第 4 集及以后的「网页可播」流地址（普通 <video> 标签直接播放）。"
msgstr "第 4 集及以後的「網頁可播」流地址（普通 <video> 標籤直接播放）。"

msgid "播放令牌"
msgstr "播放令牌"

msgid "由「播放地址」接口的 data.url 携带"
msgstr "由「播放地址」接口的 data.url 攜帶"

msgid "必填：由「播放地址」接口下发的时效令牌，无需项目签名。"
msgstr "必填：由「播放地址」接口下發的時效令牌，無需項目簽名。"

msgid "该地址由「播放地址」接口返回，供 <video> 标签直接播放，不带项目签名（浏览器加不了签名），鉴权用 URL 里的时效令牌。"
msgstr "該地址由「播放地址」接口返回，供 <video> 標籤直接播放，不帶項目簽名（瀏覽器加不了簽名），鑑權用 URL 裡的時效令牌。"

msgid "支持 HTTP Range（206）：可拖动进度条、可断点续传。"
msgstr "支持 HTTP Range（206）：可拖動進度條、可斷點續傳。"

msgid "首次点播该集的某一画质时返回 202（Retry-After: 3），服务端在后台解密并转成 H.264（约数十秒），200 / 206 才是可播放；生成失败返回 503（响应体里有失败原因），请勿只按 HTTP 200 判定。产物落盘永久复用，此后再播为即刻返回。"
msgstr "首次點播該集的某一畫質時返回 202（Retry-After: 3），服務端在後臺解密並轉成 H.264（約數十秒），200 / 206 才是可播放；生成失敗返回 503（響應體裡有失敗原因），請勿只按 HTTP 200 判定。產物落盤永久復用，此後再播為即刻返回。"

msgid "令牌无效或过期返回 403，需重新调用「播放地址」接口获取新地址。"
msgstr "令牌無效或過期返回 403，需重新調用「播放地址」接口獲取新地址。"

# ---- 短剧详情（detail）的 episodes[] 口径 ----

msgid "返回 data.episodes 为全量集列表，每项含 ep / episode_id / playable / source。"
msgstr "返回 data.episodes 為全量集列表，每項含 ep / episode_id / playable / source。"

msgid "episodes[].playable 的口径与「播放地址」接口**完全一致**：源站直链 / 本站网页直出两条路任一可用即为 true；source 标出走的哪条路 —— origin（源站直链）/ stream（本站直出，首播需等数十秒生成）。本站直出默认可用，所以第 4 集及以后通常也是 playable=true。"
msgstr "episodes[].playable 的口徑與「播放地址」接口**完全一致**：源站直鏈 / 本站網頁直出兩條路任一可用即為 true；source 標出走的哪條路 —— origin（源站直鏈）/ stream（本站直出，首播需等數十秒生成）。本站直出默認可用，所以第 4 集及以後通常也是 playable=true。"

msgid "data.playable_cnt 为源站直链的连续范围（前 N 集，保持原义）；data.listed_cnt 为实际可播集数（= playable 为 true 的集数）。需要判断「某集能不能播」请用 episodes[].playable，不要用 playable_cnt 推算。"
msgstr "data.playable_cnt 為源站直鏈的連續範圍（前 N 集，保持原義）；data.listed_cnt 為實際可播集數（= playable 為 true 的集數）。需要判斷「某集能不能播」請用 episodes[].playable，不要用 playable_cnt 推算。"

msgid "剧集不存在时返回 EXTERNAL_API_FAILED（外部API调用失败）。"
msgstr "劇集不存在時返回 EXTERNAL_API_FAILED（外部API調用失敗）。"

# ---- 短剧播放（play）的 data.source ----

msgid "前 3 集返回源站明文 MP4 直链；第 4 集及以后源站只下发 DRM 加密的 H.265（浏览器无法解码），改由本站出流。data.source 区分来源（取值与「剧集详情」的 episodes[].source 一致）："
msgstr "前 3 集返回源站明文 MP4 直鏈；第 4 集及以後源站只下發 DRM 加密的 H.265（瀏覽器無法解碼），改由本站出流。data.source 區分來源（取值與「劇集詳情」的 episodes[].source 一致）："

msgid "· origin —— 源站明文直链（前若干集）；"
msgstr "· origin —— 源站明文直鏈（前若干集）；"

msgid "· stream —— 本站直出：data.url 为可直接交给 <video> 播放的地址（明文 H.264、支持 HTTP Range 拖动），画质见 data.quality，data.ready=false 表示该画质首次被点播、服务端正在生成（约数十秒），请轮询该地址：202=正在生成、503=生成失败（响应体里有原因）、200/206=可播放，别只按 HTTP 200 判定。"
msgstr "· stream —— 本站直出：data.url 為可直接交給 <video> 播放的地址（明文 H.264、支持 HTTP Range 拖動），畫質見 data.quality，data.ready=false 表示該畫質首次被點播、服務端正在生成（約數十秒），請輪詢該地址：202=正在生成、503=生成失敗（響應體裡有原因）、200/206=可播放，別只按 HTTP 200 判定。"

# ---- 短剧出流画质（play 的 q 参数） ----

msgid "画质"
msgstr "畫質"

msgid "选填：本站直出的画质，取值是输出宽度上限（短剧是竖屏，1080 即 1080×1920，也就是日常说的 1080p）。每档产物各存一份；换画质要重新调本接口换地址。"
msgstr "選填：本站直出的畫質，取值是輸出寬度上限（短劇是豎屏，1080 即 1080×1920，也就是日常說的 1080p）。每檔產物各存一份；換畫質要重新調本接口換地址。"

msgid "1080p（源站最高，推荐）"
msgstr "1080p（源站最高，推薦）"

msgid "720p"
msgstr "720p"

msgid "540p"
msgstr "540p"

msgid "480p"
msgstr "480p"

