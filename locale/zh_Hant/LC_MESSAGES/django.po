# ==================== API 文档内容 · 爬虫验证 ====================
msgid "4759 蜘蛛 IP 验证"
msgstr "4759 蜘蛛 IP 驗證"

msgid "4759 蜘蛛/爬虫 IP 库"
msgstr "4759 蜘蛛/爬蟲 IP 庫"

msgid "GET 查询接口；本服务需项目签名。"
msgstr "GET 查詢接口；本服務需項目簽名。"

msgid "只读查询接口，支持 IPv4 与 IPv6。查询需访问外部 IP 库，单次耗时可能偏长，属正常现象。"
msgstr "只讀查詢接口，支持 IPv4 與 IPv6。查詢需訪問外部 IP 庫，單次耗時可能偏長，屬正常現象。"

msgid "只读查询接口：提交一个 IP，服务端查证其是否为搜索引擎（如百度/谷歌等）爬虫来源。"
msgstr "只讀查詢接口：提交一個 IP，服務端查證其是否為搜索引擎（如百度/谷歌等）爬蟲來源。"

msgid "如 66.249.65.205（Google 爬虫）"
msgstr "如 66.249.65.205（Google 爬蟲）"

msgid "对外部服务查询耗时可能较长，属正常；接口返回 data 为爬虫验证结果（含是否为爬虫及来源类型，以实际返回为准）。"
msgstr "對外部服務查詢耗時可能較長，屬正常；接口返回 data 為爬蟲驗證結果（含是否為爬蟲及來源類型，以實際返回為準）。"

msgid "待验证 IP"
msgstr "待驗證 IP"

msgid "必填：合法的 IPv4 或 IPv6 地址"
msgstr "必填：合法的 IPv4 或 IPv6 地址"

msgid "本服务需项目签名。识别结果依赖第三方 IP 库的覆盖范围，建议作为参考而非唯一判定条件。"
msgstr "本服務需項目簽名。識別結果依賴第三方 IP 庫的覆蓋範圍，建議作為參考而非唯一判定條件。"

msgid "爬虫验证API,环境检测接口,自动化检测"
msgstr "爬蟲驗證API,環境檢測接口,自動化檢測"

msgid "爬虫验证服务用于判断一个 IP 是否来自搜索引擎爬虫：提交 IP，服务端查询蜘蛛 IP 库并返回识别结论与来源类型，可用于访问日志分析、来源统计，或做「真爬虫才给收录内容」这类判断的辅助依据。"
msgstr "爬蟲驗證服務用於判斷一個 IP 是否來自搜索引擎爬蟲：提交 IP，服務端查詢蜘蛛 IP 庫並返回識別結論與來源類型，可用於訪問日誌分析、來源統計，或做「真爬蟲才給收錄內容」這類判斷的輔助依據。"

msgid "识别自动化/爬虫环境：验证指定 IP 是否属于搜索引擎爬虫。当前接入 4759 验证线路。"
msgstr "識別自動化/爬蟲環境：驗證指定 IP 是否屬於搜索引擎爬蟲。當前接入 4759 驗證線路。"

msgid "验证 IP 是否爬虫"
msgstr "驗證 IP 是否爬蟲"

msgid "验证给定 IP 是否为搜索引擎爬虫，返回识别结论与类型信息。"
msgstr "驗證給定 IP 是否為搜索引擎爬蟲，返回識別結論與類型信息。"

