msgstr "[{\"role\": \"system\", \"content\": \"You are a math teacher; only answer math questions\"}]"

msgid "[{\"role\": \"user\", \"content\": \"你好\"},{\"role\": \"assistant\", \"content\": \"你好！\"},{\"role\": \"user\", \"content\": \"今天天气怎么样？\"}]"
msgstr "[{\"role\": \"user\", \"content\": \"Hello\"},{\"role\": \"assistant\", \"content\": \"Hello!\"},{\"role\": \"user\", \"content\": \"What's the weather like today?\"}]"

msgid "content 与 messages 至少提供一个，否则返回参数缺失。"
msgstr "Provide at least one of content or messages, otherwise a missing parameter error is returned."

msgid "deepseek-v4-flash（快速版）"
msgstr "deepseek-v4-flash (Fast)"

msgid "deepseek-v4-pro（专业版）"
msgstr "deepseek-v4-pro (Pro)"

msgid "sk-…"
msgstr "sk-…"

msgid "一个接口覆盖单轮/多轮对话；不传 api_key 时使用平台 .env 配置的 DeepSeek Key。"
msgstr "One endpoint covers both single-turn and multi-turn chat; when api_key is omitted, the DeepSeek Key configured in the platform .env is used."

msgid "不传（默认 deepseek-v4-flash）"
msgstr "Omit (defaults to deepseek-v4-flash)"

msgid "与 DeepSeek 对话：支持单条消息、完整消息列表、系统提示词、流式/前缀续写。"
msgstr "Chat with DeepSeek: supports a single message, a full message list, a system prompt, and streaming/prefix continuation."

msgid "你好，介绍一下你自己"
msgstr "Hello, introduce yourself"

msgid "例如：```python\n"
msgstr "Example: ```python\n"

msgid "停止词"
msgstr "Stop words"

msgid "内置模型能力，开箱即用的 AI 对话接口。当前接入 DeepSeek 内置模型（含多轮对话、流式、前缀续写）。"
msgstr "Built-in model capabilities: an out-of-the-box AI chat API. Currently integrated with the DeepSeek built-in model (with multi-turn chat, streaming, and prefix continuation)."

msgid "前缀续写(Beta)"
msgstr "Prefix continuation (Beta)"

msgid "单条消息内容"
msgstr "Single message content"

msgid "同一个接口覆盖单轮与多轮对话：传 content 发起简单单轮问答，传 messages（JSON 数组，含 role 与 content）则进行多轮对话；同时支持系统提示词、流式输出与前缀续写，不传 api_key 时使用平台内置的模型密钥。"
msgstr "A single endpoint covers both single-turn and multi-turn chat: pass content for a simple one-shot question, or messages (a JSON array of role and content) for a multi-turn conversation. System prompts, streaming output and prefix completion are also supported, and omitting api_key uses the platform's built-in model key."

msgid "在线调用会真实消耗平台 DeepSeek 额度，请确认 Key/额度可用后再调试。"
msgstr "Live calls actually consume the platform's DeepSeek quota; make sure the Key/quota is available before debugging."

msgid "完整对话消息(JSON)"
msgstr "Full conversation messages (JSON)"

msgid "模型名称"
msgstr "Model name"

msgid "流式模式返回 SSE：每帧形如 data: {\"content\": \"片段\"}（答案正文）或 data: {\"reasoning\": \"片段\"}（推理模型的思考过程，仅这类模型有，与答案分开下发、只关心答案可忽略），结束标记 data: [DONE]；在线调试会逐字打印，推理模型在给出答案前会先流一段思考内容。"
msgstr "Streaming mode returns SSE: each frame is either data: {\"content\": \"chunk\"} (the answer) or data: {\"reasoning\": \"chunk\"} (a reasoning model's thinking; only such models emit it, and it is sent separately from the answer, so ignore it if you only care about the answer), terminated by data: [DONE]. The live debugger prints it character by character; a reasoning model streams some thinking before the answer begins."

msgid "流式输出(SSE)"
msgstr "Streaming output (SSE)"

msgid "系统提示词(JSON)"
msgstr "System Prompt (JSON)"

msgid "请求体为 application/x-www-form-urlencoded 表单；本服务需项目签名。"
msgstr "The request body is an application/x-www-form-urlencoded form; this service requires the project signature."

msgid "选填：true 时响应为 SSE(text/event-stream)，逐块推送"
msgstr "Optional: when true, the response is SSE (text/event-stream), pushed chunk by chunk"

msgid "选填：发起简单单轮对话时的消息内容（与 messages 至少提供一个）"
msgstr "Optional: message content for a simple single-turn chat (provide at least one of content or messages)"

msgid "选填：多轮对话用，格式为 JSON 数组，role 取 user/assistant；优先级高于 content"
msgstr "Optional: for multi-turn chat, formatted as a JSON array with role set to user/assistant; takes precedence over content"

