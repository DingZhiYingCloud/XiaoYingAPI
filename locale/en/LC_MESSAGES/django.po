msgid "订单到期或凭据错误时，服务端会返回真实原因（如「您的订单已到期」）。"
msgstr "When the order has expired or the credentials are wrong, the server returns the real reason (for example: your order has expired)."

msgid "订单号"
msgstr "Order Number"

msgid "认证密码"
msgstr "Auth Password"

msgid "认证用户名"
msgstr "Auth Username"

msgid "账号密码认证：返回每条代理附带 proxy 字段（含账号密码的完整地址）。"
msgstr "Username/password authentication: each proxy is returned with a proxy field (the full address including username and password)."

