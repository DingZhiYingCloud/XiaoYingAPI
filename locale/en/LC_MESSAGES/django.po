# ==================== API 文档内容 · 代练丸子 ====================
msgid "搜索订单（接单大厅）"
msgstr "Search orders (order hall)"

msgid "搜索接单大厅的订单：关键词 / 游戏筛选 + 分页。"
msgstr "Search orders in the taker hall by keyword / game with pagination."

msgid "data 为上游完整响应对象：分页在 data.page（pageNo / pageSize / totalPage / totalCount），订单数组在 data.ordersList。"
msgstr "data is the raw upstream response: pagination in data.page (pageNo / pageSize / totalPage / totalCount), orders in data.ordersList."

msgid "【用途】接单前找单：拿到 `trade_no` 后可用「大厅订单详情」核对，再调「接单」接手。"
msgstr "[Usage] Find an order before taking it: inspect the returned `trade_no` via \"Hall order detail\", then call \"Take order\"."

msgid "【分页】上游用 `pageNo`/`pageSize`（对外仍是 `page`/`page_size`）。"
msgstr "[Pagination] Upstream uses `pageNo`/`pageSize` (this API keeps `page`/`page_size`)."

msgid "【热搜词】搜索框推荐词见「大厅热搜词」接口。"
msgstr "[Hot words] Search suggestions are available via the \"Hall hot words\" endpoint."

msgid "选填：标题 / 角色名 / 段位等；不传按默认顺序返回"
msgstr "Optional: title / character name / rank, etc.; omit for the default order."

msgid "王者"
msgstr "Honor of Kings"

msgid "0"
msgstr "0"

msgid "1"
msgstr "1"

msgid "选填：按游戏筛选（见「获取全部游戏」）"
msgstr "Optional: filter by game (see \"List all games\")."

msgid "大厅热搜词"
msgstr "Hall hot words"

msgid "接单大厅搜索框的推荐热词。"
msgstr "Suggested keywords for the hall search box."

msgid "data.wordList 为热词数组。"
msgstr "data.wordList is an array of hot words."

msgid "大厅订单详情"
msgstr "Hall order detail"

msgid "按订单号查看大厅订单详情（接单前核对金额 / 双金 / 区服 / 代练要求）。"
msgstr "View a hall order by trade no (check amount / deposits / region / requirements before taking)."

msgid "data 为上游订单对象：amount / hour / securityDeposit / efficiencyDeposit / totalDeposit / title / gameRegionName 等。"
msgstr "data is the upstream order object: amount / hour / securityDeposit / efficiencyDeposit / totalDeposit / title / gameRegionName, etc."

msgid "必填：订单号（「搜索订单」返回的 tradeNo）"
msgstr "Required: trade no (the tradeNo returned by \"Search orders\")."

msgid "接单密码校验"
msgstr "Verify take password"

msgid "指定单接单前校验「接单密码」。"
msgstr "Verify the \"take password\" before taking a designated order."

msgid "密码正确返回 code=10000。"
msgstr "Returns code=10000 when the password is correct."

msgid "接单"
msgstr "Take order"

msgid "接单（真实接手，双金从接单方余额冻结）。"
msgstr "Take an order (really takes it; deposits are frozen from the taker's balance)."

msgid "data 为上游响应对象，含 noneBalanceEnough / noneSetPayPwd / noneRealNameAuth 等校验标记。"
msgstr "data is the upstream response with checks such as noneBalanceEnough / noneSetPayPwd / noneRealNameAuth."

msgid "【会真实接单】成功后订单进入「代练中」，并按 安全保证金 + 效率保证金从**接单方余额**冻结双金（实测 2 元订单双金 2+2=4 元）。"
msgstr "[Really takes the order] On success the order becomes \"In progress\", and (security + efficiency) deposits are frozen from the **taker's balance** (a 2 CNY order froze 2+2=4 CNY in testing)."

msgid "【支付密码必填】缺 `pay_password` 会被上游拒绝（接单流程处理异常）。"
msgstr "[Pay password required] Upstream rejects the request without `pay_password` (\"take flow error\")."

msgid "【指定单】需要「接单密码」，可先用「接单密码校验」确认。"
msgstr "[Designated orders] need the \"take password\"; verify it first with \"Verify take password\"."

msgid "【重复接单】已被接手的单上游返回「该订单已被接手」，本接口映射为 40001。"
msgstr "[Already taken] Upstream returns \"the order has already been taken\", mapped to 40001 here."

msgid "必填：订单号（「搜索订单」/「大厅订单详情」得到）"
msgstr "Required: trade no (from \"Search orders\" / \"Hall order detail\")."

msgid "必填：本账号支付密码，用于冻结双金"
msgstr "Required: this account's pay password, used to freeze deposits."

msgid "选填：指定单才需要（可先用「接单密码校验」）"
msgstr "Optional: only needed for designated orders (verify first with \"Verify take password\")."

msgid "申请撤销"
msgstr "Apply for revocation"

msgid "申请撤销（提前终止代练），需对方同意才生效。"
msgstr "Apply for revocation (end the order early); it takes effect once the other side agrees."

msgid "成功返回 code=10000。"
msgstr "Returns code=10000 on success."

msgid "【流程】申请后订单进入「撤销中」(status=5)，对方「同意撤销」后按资金分配方案结算。"
msgstr "[Flow] After applying, the order becomes \"Revoking\" (status=5); once the other side agrees, funds settle per the plan."

msgid "【资金分配】`pay_amount` = 我愿支付的代练费（打手未开始代练填 0）；`deposit` = 对方需赔付的保证金（对方无违规填 0）。"
msgstr "[Fund allocation] `pay_amount` = service fee you are willing to pay (0 if the taker has not started); `deposit` = compensation from the other side (0 if no violation)."

msgid "【initiator】1=发单方 / 2=接单方（本方身份）。"
msgstr "[initiator] 1 = order publisher / 2 = taker (your side's role)."

msgid "【原因必填】`reason` 写清订单进度 + 撤销理由，客服据此处理。"
msgstr "[Reason required] `reason` should state the order progress + the reason; support handles it based on this."

msgid "【凭证图片必填】上游强制要求先关联凭证图片，缺 `images` 会被拒（「请补充传图」）。"
msgstr "[Images required] Upstream requires evidence images to be linked first; the request is rejected without `images` (\"please add images\")."

msgid "凭证图片"
msgstr "Evidence images"

msgid "必填：凭证图片URL列表（JSON 字符串数组，至少一张）"
msgstr "Required: list of evidence image URLs (JSON string array, at least one)."

msgid "发起方"
msgstr "Initiator"

msgid "1 = 发单方"
msgstr "1 = Order publisher"

msgid "2 = 接单方"
msgstr "2 = Taker"

msgid "撤销理由"
msgstr "Revocation reason"

msgid "未开始代练，双方无违规，资金分配填 0"
msgstr "Not started yet, no violation on either side, fund allocation 0"

msgid "对方赔付保证金(元)"
msgstr "Compensation deposit (CNY)"

msgid "选填：对方无违规填 0"
msgstr "Optional: 0 if the other side has no violation."

msgid "我愿支付代练费(元)"
msgstr "Service fee I pay (CNY)"

msgid "选填：打手未开始代练填 0"
msgstr "Optional: 0 if the taker has not started."

msgid "超时自动仲裁"
msgstr "Auto arbitration on timeout"

msgid "选填：对方超时未处理是否自动转仲裁（接单方发起时可用）"
msgstr "Optional: whether to auto-escalate to arbitration if the other side times out (for taker-initiated requests)."

msgid "否"
msgstr "No"

msgid "同意撤销"
msgstr "Agree to revocation"

msgid "同意对方的撤销申请（生效后按申请单的资金分配方案结算）。"
msgstr "Agree to the other side's revocation request (funds settle per the request's plan)."

msgid "data 含 revocationsDataBean（撤销单详情）。"
msgstr "data contains revocationsDataBean (revocation details)."

msgid "【会真实结算】同意后订单变为「已完结」，双金 / 代练金按申请单释放（实测：双方都填 0 时，接单方 4 元双金原路退回）。"
msgstr "[Really settles] After agreeing, the order becomes \"Finished\" and deposits/fee are released per the request (testing: with both sides at 0, the taker's 4 CNY deposits were returned)."

msgid "【支付密码】发单方同意时上游要求 `pay_password` 必填；接单方可省略。"
msgstr "[Pay password] Upstream requires `pay_password` when the order publisher agrees; the taker may omit it."

msgid "选填：发单方同意时必填；接单方可省略"
msgstr "Optional: required when the order publisher agrees; the taker may omit it."

msgid "取消撤销"
msgstr "Cancel revocation"

msgid "撤回已提交的撤销申请。"
msgstr "Withdraw a submitted revocation request."

msgid "订单状态已变更等场景返回 40001。"
msgstr "Returns 40001 when e.g. the order status has already changed."

msgid "申请仲裁"
msgstr "Apply for arbitration"

msgid "申请平台仲裁（订单产生争议时）。"
msgstr "Apply for platform arbitration (when the order is disputed)."

msgid "【凭证图片必填】上游强制要求先关联举证图片，缺 `images` 会被拒。"
msgstr "[Images required] Upstream requires evidence images to be linked first; the request is rejected without `images`."

msgid "【不可撤销】仲裁发起后只能等待平台处理（预计 48 小时内）。"
msgstr "[Irreversible] Once arbitration is filed, you can only wait for the platform (usually within 48 hours)."

msgid "操作方"
msgstr "Operator"

msgid "仲裁理由"
msgstr "Arbitration reason"

msgid "举证图片"
msgstr "Evidence images"

msgid "必填：举证图片URL列表（JSON 字符串数组，至少一张）"
msgstr "Required: list of evidence image URLs (JSON string array, at least one)."

msgid "争议代练费(元)"
msgstr "Disputed service fee (CNY)"

msgid "争议保证金(元)"
msgstr "Disputed deposit (CNY)"

msgid "操作类型"
msgstr "Operation type"

msgid "商家版发布订单（真实下单）：用上方「发单选项」面板选游戏/大区/代练类型与任务字段即可，免填 JSON。"
msgstr "Merchant publish order (places a real order): use the \"Order options\" panel above to pick game / region / leveling type and task fields — no JSON needed."

msgid "【怎么填】用上方「发单选项」面板：选游戏 → 大区 → 代练类型，任务字段（段位 / 数量 / 下拉）会自动出现并按预设预填；面板会把 `game_id` / `region_name` / `leveling_type_name` / `tasks` 一并带给接口（**不用手写 JSON**）。选王者只显示王者的字段，选三角洲只显示三角洲的字段。"
msgstr "[How to fill] Use the \"Order options\" panel above: pick game → region → leveling type; the task fields (rank / quantity / select) appear automatically and are prefilled from the preset. The panel passes `game_id` / `region_name` / `leveling_type_name` / `tasks` along with the request (**no JSON needed**). Choosing Honor of Kings shows only its fields; choosing Delta Force shows only its fields."

msgid "【会真实下单】按传入价格从商家余额扣款；取消用「取消订单」接口（金额原路退回）。"
msgstr "[Places a real order] The price is deducted from the merchant balance; to cancel, use the \"Cancel order\" endpoint (the amount is refunded)."

msgid "【不传也能发】`game_id`=1（王者）/ 134（三角洲）有内置预设（王者=排位/安卓QQ/青铜3段0星→王者50星/铭文150/英雄170；三角洲=哈夫币代刷/手机QQ/哈夫币100万/代肝/保险箱2格），面板已按此预填。"
msgstr "[Presets] `game_id`=1 (Honor of Kings) / 134 (Delta Force) have built-in presets (HoK=Ranked/Android QQ/Bronze III 0 star→King 50 star/Inscription 150/Heroes 170; Delta Force=Havoc Coin farming/Mobile QQ/1,000,000 Havoc Coin/Self-farmed/Case 2 slots); the panel is prefilled accordingly."

msgid "发单选项"
msgstr "Order options"

msgid "选好游戏 / 大区 / 代练类型，下方的任务字段会跟着变；无需手写 JSON。"
msgstr "Pick a game / region / leveling type; the task fields below follow along — no JSON needed."

msgid "选择游戏"
msgstr "Choose game"

msgid "选择大区"
msgstr "Choose region"

msgid "选择代练类型"
msgstr "Choose leveling type"

msgid "商家版取消已发布的订单（待付待接等可取消状态）。"
msgstr "Merchant version: cancel a published order (pending payment/acceptance and other cancellable states)."

msgid "data 为上游完整响应对象（原样透传）。"
msgstr "`data` is the upstream response object passed through as-is."

msgid "【会真实改变订单状态】仅「待付待接」等可取消状态可取消；取消后订单金额**原路退回**商家余额（实测 2 元订单取消后余额 +2）。"
msgstr "[Changes the order state for real] Only cancellable states (e.g. pending payment/acceptance) can be cancelled; the order amount is **refunded to the merchant balance** (verified: a CNY 2 order adds +2 back to the balance)."

msgid "必填：订单号（「发布订单」返回的 trade_no，如 WZ20261004121328255441）"
msgstr "Required: order number (the `trade_no` returned by \"Publish Order\", e.g. WZ20261004121328255441)."

msgid "代练丸子平台能力：验证码登录、用户资料/头像/实名/签到、余额查询；商家版「我的订单」（分类与列表）与「发布订单」（发单选项 / 一键发单）。"
msgstr "DaiLianWanZi platform capabilities: SMS-code log in, user profile/avatar/real-name/sign-in, balance query; the merchant version's \"My Orders\" (categories and list) and \"Publish Order\" (order options / one-click publish)."

msgid "代练丸子API,代练订单接口,代练丸子发单"
msgstr "DaiLianWanZi API,Boosting Order API,DaiLianWanZi publish order"

msgid "代练丸子分**打手版**与**商家版**两条线路：打手版接口正在建设中；商家版提供验证码登录（服务端自动完成图形验证码识别）、用户资料与头像维护、实名查询、每日签到、余额查询，「我的订单」（订单分类与订单列表），以及**发布订单**（发单选项查询 + 一键发单）。"
msgstr "DaiLianWanZi has two channels: **Player** (the API is under construction) and **Merchant**. The Merchant version provides SMS-code log in (the server completes the graphic CAPTCHA automatically), user profile and avatar management, real-name verification lookup, daily check-in, balance query, \"My Orders\" (order categories and order list), and **Publish Order** (order-options lookup + one-click publish)."

msgid "获取全部游戏"
msgstr "All Games"

msgid "商家版发单用：全部游戏（仅 id + 名称，代练丸子没有「每个游戏的订单数」）。"
msgstr "For merchant publishing: all games (only id + name; DaiLianWanZi does not expose a per-game order count)."

msgid "data 为游戏数组 [{game_id, game_name}]，热门游戏在前（如 1=王者 / 134=三角洲行动）。"
msgstr "`data` is a game array [{game_id, game_name}]; hot games come first (e.g. 1=Honor of Kings / 134=Delta Force)."

msgid "获取发单选项"
msgstr "Order Options"

msgid "商家版发单用：大区 + 代练类型 +（指定代练类型时）子类型字段（段位 / 数量等）。"
msgstr "For merchant publishing: regions + leveling types + (when a leveling type is given) its sub-type fields (rank / quantity, etc.)."

msgid "data 含 `regions`（大区，server 为默认服）、`leveling_types`（代练类型）、`fields`（子类型字段：下拉类带 options、段位类带 levels、数字类带 min_val/max_val）。"
msgstr "`data` contains `regions` (with `server` = the default server), `leveling_types`, and `fields` (sub-type fields: select fields carry options, rank fields carry levels, numeric fields carry min_val/max_val)."

msgid "【怎么用】先调「获取全部游戏」拿 `game_id` → 调本接口拿 `regions` 与 `leveling_types` → 想发某个代练类型时，再把该类型的 `leveling_type_id` 传进来，拿到它的字段与可选值。"
msgstr "[How to use] First call \"All Games\" to get `game_id` → call this endpoint for `regions` and `leveling_types` → to publish a specific leveling type, pass its `leveling_type_id` to get its fields and allowed values."

msgid "【字段类型】`fields[].type`：1=单选（带 `options`）、5=数字（带 `min_val/max_val`）、6=段位区间（带 `levels`，如「青铜3段0星」「王者50星」）。"
msgstr "[Field types] `fields[].type`: 1=single select (with `options`), 5=number (with `min_val/max_val`), 6=rank range (with `levels`, e.g. \"Bronze III 0 star\", \"King 50 star\")."

msgid "必填：游戏ID（由「获取全部游戏」取到）"
msgstr "Required: game ID (from \"All Games\")."

msgid "代练类型ID"
