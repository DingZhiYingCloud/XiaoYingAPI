msgstr "items[].capacity_mb / items[].capacity_bytes: total capacity of the Token"

msgid "items[].create_time：该 Token 的入库时间"
msgstr "items[].create_time: when the Token was added"

msgid "items[].remaining_mb / items[].remaining_bytes：该 Token 的剩余容量（= 容量 − 已用，最小为 0）"
msgstr "items[].remaining_mb / items[].remaining_bytes: remaining capacity of the Token (= capacity minus used, minimum 0)"

msgid "items[].token：Token 脱敏值（保留首 6 位与末 4 位，如 657|uN****afdb）"
msgstr "items[].token: masked Token value (first 6 and last 4 characters kept, e.g. 657|uN****afdb)"

msgid "items[].used_mb / items[].used_bytes：该 Token 的已用容量"
msgstr "items[].used_mb / items[].used_bytes: used capacity of the Token"

