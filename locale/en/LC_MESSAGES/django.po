# ===== 控制台安全页（2026-10-01 第三批次） =====

msgid "安全"
msgstr "Security"

msgid "安全设置"
msgstr "Security Settings"

msgid "安全设置 - 超级管理员 - 小影API"
msgstr "Security Settings - Super Admin - XiaoYingAPI"

msgid "超级管理员,安全设置,后台入口隐身,路径探测"
msgstr "Super Admin, security settings, hidden admin entry, path probing"

msgid "小影API 超级管理员：控制台自身的安全开关，防止后台入口被路径探测发现。"
msgstr "XiaoYingAPI Super Admin: the console's own security switches, preventing the admin entry from being discovered by path probing."

msgid "控制台自身的安全开关：防止后台入口被路径探测发现。"
msgstr "The console's own security switches: prevent the admin entry from being discovered by path probing."

msgid "控制台自身的安全开关：后台入口隐身（未登录访问后台一律返回 404，防止被路径探测发现入口）。"
msgstr "The console's own security switches: hidden admin entry (unauthenticated visits to the admin area always return 404, so path probing cannot discover the entry)."

msgid "「后台入口隐身」开启后，未登录（或非超管）访问后台地址一律返回 404，与访问一个根本不存在的地址表现完全一致。"
msgstr "When \"hidden admin entry\" is on, an unauthenticated (or non-superadmin) visit to any admin URL always returns 404 — exactly the same as visiting an address that does not exist at all."

msgid "为什么需要它：若未登录访问后台时跳转登录页，等于明确告诉探测者「这个地址存在」，对方据此就能把后台入口定位出来。"
msgstr "Why it is needed: if an unauthenticated visit to the admin area redirects to the login page, that plainly tells a prober \"this address exists\", which is enough for them to pin down the admin entry."

msgid "代价：开启后你自己也要先从 /login/ 登录，再访问后台才能进入（登录成功后首页有「超级管理员」入口）。"
msgstr "Trade-off: once it is on, you too must sign in at /login/ first before the admin area opens (the home page shows a \"Super Admin\" entry after signing in)."

msgid "边界：登录页本身仍然公开（任何站点都有登录页），本开关只隐藏后台，不隐藏登录页。"
msgstr "Scope: the login page itself stays public (every site has a login page); this switch only hides the admin area, not the login page."

msgid "后台入口"
msgstr "Admin Entry"

msgid "后台入口隐身"
msgstr "Hidden admin entry"

msgid "已开启"
msgstr "On"

msgid "已关闭"
msgstr "Off"

msgid "未登录访问后台一律返回 404；关闭则退回「跳转登录页」的行为。"
msgstr "Unauthenticated visits to the admin area always return 404; turning it off falls back to the \"redirect to login\" behaviour."

msgid "安全设置已保存"
msgstr "Security settings saved"


