msgstr "Business logic errors"

msgid "第三方/外部服务错误"
msgstr "Third-party / external service errors"

msgid "系统内部错误"
msgstr "Internal server errors"

msgid "未分类"
msgstr "Uncategorized"

# ---- 错误码总表：触发场景 / 处理建议（API/website/docs/errors.py） ----

msgid "必填参数没有传。"
msgstr "A required parameter was not provided."

msgid "对照该接口「请求参数」表里标为必填的字段补齐后重试。"
msgstr "Check the endpoint's Parameters table and supply every required field, then retry."

msgid "参数格式不对，比如该传数字却传了文字、JSON 体无法解析。"
msgstr "A parameter has the wrong format — e.g. text where a number is expected, or an unparsable JSON body."

msgid "检查参数取值格式与请求体编码，并确认 Content-Type 与实际内容一致（JSON 用 application/json）。"
msgstr "Check the value format and body encoding, and make sure Content-Type matches the body (use application/json for JSON)."

msgid "参数值本身不合法，比如超出取值范围、传入的 ID 不存在。"
msgstr "The value itself is invalid — e.g. out of the allowed range, or an ID that does not exist."

msgid "核对该参数文档里的取值说明后重新提交。"
msgstr "Check the documented allowed values for that parameter and submit again."

msgid "请求没有携带认证信息。"
msgstr "The request carries no authentication information."

msgid "按「签名说明」在请求头带上 APPID、时间戳与签名后重试。"
msgstr "Follow the Signing section: send APPID, timestamp and signature in the request headers, then retry."

msgid "签名校验不通过：密钥错误、参数被改动，或时间戳已过期。"
msgstr "Signature verification failed: wrong secret, modified parameters, or an expired timestamp."

msgid "用 APPSECRET 重新生成签名，确认时间戳在有效期内且参与签名的是原样参数。"
msgstr "Regenerate the signature with your APPSECRET, and make sure the timestamp is still valid and that the exact parameters were signed."

msgid "身份合法但无权访问：项目未开通该服务，或账号被策略限制。"
msgstr "Authenticated but not allowed: the project has not enabled this service, or the account is restricted by policy."

msgid "确认项目已开通对应服务；仍有问题请联系管理员。"
msgstr "Make sure the project has enabled this service; contact the administrator if the problem persists."

msgid "请求的路径不存在，或引用的资源不存在。"
msgstr "The requested path does not exist, or the referenced resource does not exist."

msgid "核对请求 URL 与资源 ID 是否正确。"
msgstr "Double-check the request URL and the resource ID."

msgid "短时间请求过于频繁（例如登录连续失败被临时锁定）。"
msgstr "Too many requests in a short time (for example, repeated login failures temporarily locked the account)."

msgid "降低请求频率、稍后重试。"
msgstr "Slow down and retry later."

msgid "使用了该接口不支持的 HTTP 方法。"
msgstr "The endpoint does not support this HTTP method."

msgid "按文档标注的方法（GET / POST 等）发起请求。"
msgstr "Use the method shown in the docs (GET / POST, etc.)."

msgid "违反业务规则，例如当前账号状态不允许该操作。"
msgstr "A business rule was violated — e.g. the current account state does not allow this action."

msgid "按返回的 msg 提示处理；属于账号限制的请联系管理员。"
msgstr "Follow the returned msg; if it is an account restriction, contact the administrator."

msgid "对象当前状态不允许执行该操作。"
msgstr "The object's current state does not allow this action."

msgid "按提示调整对象状态后再试。"
msgstr "Adjust the object state as prompted, then retry."

msgid "该服务正在维护，命中路径的请求被统一拦截。"
msgstr "This service is under maintenance; requests to it are blocked."

msgid "稍后重试，或关注该服务的公告。"
msgstr "Retry later, or watch the service announcements."

msgid "该服务已下线。"
msgstr "This service has been taken offline."

msgid "改用其它可用服务或线路。"
msgstr "Switch to another available service or channel."

msgid "该服务还在开发中，暂未对外开放。"
msgstr "This service is still under development and not yet available."

msgid "等待服务上线后再调用。"
msgstr "Wait until the service goes live."

msgid "项目的当日 / 当月调用量已达到配额上限。"
msgstr "The project has reached its daily / monthly call quota."

msgid "等待配额周期重置，或联系管理员调整配额。"
msgstr "Wait for the quota period to reset, or contact the administrator to adjust the quota."

msgid "平台调用上游第三方服务失败（上游异常或网络问题）。"
msgstr "The platform failed to call an upstream third-party service (upstream error or network issue)."

msgid "稍后重试；若持续失败请反馈，平台会排查上游链路。"
msgstr "Retry later; if it keeps failing, report it and we will investigate the upstream link."

msgid "服务端发生未预期的内部异常。"
msgstr "The server hit an unexpected internal error."

msgid "稍后重试；若持续失败请反馈。"
msgstr "Retry later; if it keeps failing, report it."

msgid "服务暂时不可用（维护或过载）。"
msgstr "The service is temporarily unavailable (maintenance or overload)."

msgid "稍后重试。"
msgstr "Retry later."

msgid "发生了未归类的错误。"
msgstr "An unclassified error occurred."

