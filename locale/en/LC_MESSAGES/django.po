msgstr "Optional: if omitted, the platform .env value (PROXY_QY_RES_HOST) is used"

msgid "选填：不传则用平台 .env（PROXY_QY_RES_PASSWORD）"
msgstr "Optional: if omitted, the platform .env value (PROXY_QY_RES_PASSWORD) is used"

