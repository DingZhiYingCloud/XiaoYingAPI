# ==================== API 文档内容 · 图形验证 ====================
msgid "4dc3cfc2cdff448cad8d13107198d473"
msgstr "4dc3cfc2cdff448cad8d13107198d473"

msgid "success=验证有效，fail=验证无效（pass_token 过期/流水号已用等），原因见 data.reason。"
msgstr "success=verification valid, fail=verification invalid (pass_token expired, serial number already used, etc.); see data.reason for the cause."

msgid "上传客户端验证参数，确认用户本次图形验证有效（防绕过）。"
msgstr "Upload client verification parameters to confirm that the user's current Graphic CAPTCHA verification is valid (anti-bypass)."

msgid "两步接入：先用 config 拿 appId 初始化前端 SDK，用户验证通过后再用 verify 做服务端二次校验。"
msgstr "Two-step integration: first call config to get the appId and initialize the frontend SDK, then call verify for server-side secondary validation after the user passes verification."

msgid "为避免被绕过，验证结果必须在服务端二次核验，不能只依赖前端回调。"
msgstr "To prevent bypassing, the result must be verified again server-side and never trusted from a frontend callback alone."

msgid "二次校验"
msgstr "Secondary Validation"

msgid "响应 data.app_id 即前端 initAlicom4({ captchaId: app_id, product: \"bind\" }, ...) 所需的 captchaId。"
msgstr "The response data.app_id is the captchaId required by the frontend initAlicom4({ captchaId: app_id, product: \"bind\" }, ...)."

msgid "图形验证服务集成阿里云图形验证码（滑块、点选等行为验证），用于在注册、登录、发短信等入口拦截机器流量：前端先用配置接口拿到 appId 初始化 SDK 并完成验证，再把验证参数交给业务后端调用核验接口，确认本次验证真实有效。"
msgstr "The graphic CAPTCHA service integrates Alibaba Cloud CAPTCHA (slider, click-select and other behavioral challenges) to block bot traffic at entry points such as sign-up, log-in and SMS sending: the frontend first fetches the config to obtain the appId, initializes the SDK and completes the challenge, then hands the verification parameters to your backend, which calls the check API to confirm the challenge was genuinely passed."

msgid "必填：前端 SDK 验证通过后回调返回的 captchaOutput"
msgstr "Required: the captchaOutput returned by the frontend SDK callback after verification passes"

msgid "必填：前端 SDK 验证通过后回调返回的 genTime"
msgstr "Required: the genTime returned by the frontend SDK callback after verification passes"

msgid "必填：前端 SDK 验证通过后回调返回的 passToken"
msgstr "Required: the passToken returned by the frontend SDK callback after verification passes"

msgid "必填：前端 SDK 验证通过后回调返回的流水号，32 位小写 hex"
msgstr "Required: the serial number returned by the frontend SDK callback after verification passes, a 32-character lowercase hex string"

msgid "接口请求成功统一返回 code=10000；业务结果以 data.result 判断："
msgstr "A successful request always returns code=10000; determine the business result from data.result: "

msgid "滑块验证码API,行为验证码,图形验证接口"
msgstr "Slider CAPTCHA API,Behavioral CAPTCHA,Graphic CAPTCHA API"

msgid "获取图形认证配置"
msgstr "Get Graphic Authentication Config"

msgid "该线路整体为开放接口，config 与 verify 均无需项目签名，便于前端直接集成。"
msgstr "This channel is entirely open, so both config and verify need no project signature, which makes frontend integration straightforward."

msgid "请求体为 application/x-www-form-urlencoded 表单；公开接口，无需项目签名。"
msgstr "The request body is an application/x-www-form-urlencoded form; this is a public Endpoint with no project signature required."

msgid "返回图形认证 appId（captchaId），供 H5 前端 SDK 初始化。公开接口，无需签名。"
msgstr "Returns the graphic authentication appId (captchaId) for H5 frontend SDK initialization. Public Endpoint, no signature required."

msgid "阿里云图形认证"
msgstr "Alibaba Cloud Graphic Authentication"

msgid "阿里云图形认证服务（滑块/点选验证）"
msgstr "Alibaba Cloud graphic authentication service (Slider/Click-word verification)"

msgid "阿里云图形验证码集成（滑块/点选等），服务端下发配置并二次校验，防机器流量。当前接入阿里云线路。"
msgstr "Alibaba Cloud Graphic CAPTCHA integration (Slider/Click-word, etc.), with server-side config delivery and secondary validation to prevent bot traffic. Currently connected to the Alibaba Cloud Channel."

msgid "验证流水号"
msgstr "Verification Serial Number"

msgid "验证输出信息"
msgstr "Verification Output"

msgid "验证通过时间戳"
msgstr "Verification Pass Timestamp"

msgid "验证通过标识"
msgstr "Verification Pass Token"

# ==================== API 文档内容 · 自研图形验证码 ====================
msgid "4"
msgstr "4"

msgid "7H4K"
msgstr "7H4K"

msgid "9f1c1f14-6b0a-4a3e-9c31-2c9b6f0d1a55"
msgstr "9f1c1f14-6b0a-4a3e-9c31-2c9b6f0d1a55"

msgid "SpiderServices/Captcha 自研生成引擎（Pillow 绘制）"
msgstr "SpiderServices/Captcha self-developed generation engine (drawn with Pillow)"

msgid "arithmetic（算术）"
msgstr "arithmetic (math)"

msgid "captcha_id 非 UUID 时返回 code=20002，参数缺失时返回 code=20001。"
msgstr "A non-UUID captcha_id returns code=20002; a missing parameter returns code=20001."

msgid "char（字符图片，默认）"
msgstr "char (character image, default)"

msgid "两步接入：先 generate 拿 captcha_id 与图片（base64），用户作答后 POST verify 校验；答案一次性，校验后无论对错立即失效，需配合前端换新图。"
msgstr "Two-step integration: call generate first to obtain a captcha_id and image (base64), then POST the user answer to verify. The answer is single-use: it expires immediately after validation, correct or not, so the frontend must fetch a new image afterwards."

msgid "图形验证码API,字符验证码,算术验证码"
msgstr "Graphic CAPTCHA API,Character CAPTCHA,Arithmetic CAPTCHA"

msgid "字符个数"
msgstr "Character Count"

msgid "必填：生成接口返回的 captcha_id（UUID）"
msgstr "Required: the captcha_id (UUID) returned by the generate Endpoint"

msgid "必填：用户填写的答案（字符不区分大小写；算术填计算结果）"
msgstr "Required: the answer entered by the user (case-insensitive for characters; enter the computed result for arithmetic)"

msgid "接入为两步：先调用生成接口拿到 captcha_id 与 base64 图片（带有效期），用户作答后调用校验接口提交答案。答案是「一次性」的——无论校验成功还是失败都会立即失效，失败后需重新生成再试。"
msgstr "Integration takes two steps: call the generate API to obtain a captcha_id and a base64 image with a validity period, then call the verify API with the user's answer. Answers are one-time: the challenge is invalidated immediately whether verification succeeds or fails, so a new image must be generated before retrying."

msgid "提交用户答案校验，一次性消费（校验后立即失效）。"
msgstr "Submit the user answer for validation; the CAPTCHA is consumed on use (invalidated immediately after validation)."

msgid "未通过（答案错误 / 已过期 / 已使用 / 不存在）：code=20003 且 data.passed=false，原因见 msg；"
msgstr "Not passed (wrong answer / expired / already used / not found): code=20003 with data.passed=false; see msg for the cause;"

msgid "校验通过：code=10000 且 data.passed=true；"
msgstr "Validation passed: code=10000 with data.passed=true;"

msgid "校验验证码"
msgstr "Validate CAPTCHA"

msgid "生成一张验证码，返回 captcha_id、base64 图片与有效期。"
msgstr "Generate one CAPTCHA and return its captcha_id, base64 image and validity period."

msgid "生成验证码"
msgstr "Generate CAPTCHA"

msgid "用户答案"
msgstr "User Answer"

msgid "答案一次性：同一条验证码重复提交只会成功一次，失败后需重新调用 generate。"
msgstr "The answer is single-use: repeated submissions of the same CAPTCHA can succeed only once, so call generate again after a failure."

msgid "自研图形验证码不依赖任何第三方服务，由平台用 Pillow 在本地绘制字符图片或算术题，适合对数据外发敏感、或希望零成本自建验证码的场景。"
msgstr "The self-hosted CAPTCHA depends on no third-party service: the platform draws character images or arithmetic questions locally with Pillow, making it suitable when data must not leave your infrastructure or when you want a zero-cost in-house CAPTCHA."

msgid "自研图形验证码（字符图片 / 算术），Pillow 本地绘制、无第三方依赖，答案一次性校验。"
msgstr "Self-developed CAPTCHA (character image / arithmetic), rendered locally with Pillow and no third-party dependency; each answer is validated only once."

msgid "自研验证码"
msgstr "Self-developed CAPTCHA"

msgid "该线路为开放接口，无需项目签名；生产环境建议同时限制单 IP、单账号的校验频率。"
msgstr "This channel is open and needs no project signature; in production, also throttle verification attempts per IP and per account."

msgid "请求体为 application/x-www-form-urlencoded 表单；开放接口，无需项目签名。"
msgstr "The request body is an application/x-www-form-urlencoded form; this is an open endpoint and needs no project signature."

msgid "请求方式 GET，参数放 query string；公开接口，无需项目签名。"
msgstr "Request method GET with parameters in the query string; public Endpoint, no project signature required."

msgid "返回 data.captcha_id 必须与答案一起回传给 verify；data.image 为 base64 data URI，可直接用于 <img src>；data.expire_in 为有效期（秒，默认 300）。"
msgstr "The returned data.captcha_id must be sent back to verify together with the answer; data.image is a base64 data URI usable directly in <img src>; data.expire_in is the validity period in seconds (default 300)."

msgid "选填：char=字符图片（数字+大写字母）；arithmetic=算术加减法"
msgstr "Optional: char = character image (digits + uppercase letters); arithmetic = addition / subtraction"

msgid "选填：仅 kind=char 生效，取值 4-6（默认 4）"
msgstr "Optional: only applies when kind=char; valid range 4-6 (default 4)"

msgid "验证码ID"
msgstr "CAPTCHA ID"

