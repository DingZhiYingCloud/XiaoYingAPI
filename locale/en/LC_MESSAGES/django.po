msgstr "Optional: xml is not supported (ip:port cannot be parsed)."

msgid "选填：与 username 成对出现；使用该模式无需白名单"
msgstr "Optional: used together with username; this mode requires no whitelist"

msgid "选填：与 username 成对；不传则用平台 .env（PROXY_JULIANG_PASSWORD）"
msgstr "Optional: paired with username; if omitted, the platform .env value (PROXY_JULIANG_PASSWORD) is used."

msgid "选填：仅 result_type=text 时生效"
msgstr "Optional: takes effect only when result_type=text."

msgid "选填：代理源名称，多个用英文逗号分隔，如 \"66daili,qy\""
msgstr "Optional: proxy source names, separated by English commas, e.g. \"66daili,qy\""

msgid "选填：代理认证账号，与 password 成对；不传则用平台 .env（PROXY_JULIANG_USERNAME）"
msgstr "Optional: proxy auth username, paired with password; if omitted, the platform .env value (PROXY_JULIANG_USERNAME) is used."

msgid "选填：单次提取数量，1-100，默认 1"
msgstr "Optional: number of proxies to extract per call, 1-100, default 1."

msgid "选填：在附加列返回城市名"
msgstr "Optional: return the city name in an extra column."

msgid "选填：在附加列返回城市编码"
msgstr "Optional: return the city code in an extra column."

msgid "选填：在附加列返回该 IP 剩余可用时长"
msgstr "Optional: return the remaining lifetime of each IP in an extra column."

msgid "选填：在附加列返回账密认证信息"
msgstr "Optional: return the username/password auth info in an extra column."

msgid "选填：巨量代理业务编号；不传则用平台 .env（PROXY_JULIANG_TRADE_NO）"
msgstr "Optional: Juliang business ID; if omitted, the platform .env value (PROXY_JULIANG_TRADE_NO) is used."

msgid "选填：按地区筛选，多个用英文逗号分隔"
msgstr "Optional: filter by region; separate multiple values with commas."

msgid "选填：按官方规则算好的 32 位小写 MD5（服务端会作为官方的 sign 发送）；与 key 二选一；传 custom_sign 时参数原样透传，服务端不做任何补全"
msgstr "Optional: the 32-character lowercase MD5 computed per the official rules (the server sends it as the official sign); choose either this or key. When custom_sign is provided, parameters are passed through as-is with no server-side defaults."

msgid "选填：按运营商筛选（电信 / 联通 / 移动）"
msgstr "Optional: filter by ISP (China Telecom / China Unicom / China Mobile)."

msgid "选填：提取时自动把调用方 IP 加入白名单"
msgstr "Optional: automatically add the caller IP to the whitelist when extracting."

msgid "选填：由服务端代算签名，可自由传其它参数；与 custom_sign 二选一；不传则用平台 .env（PROXY_JULIANG_KEY）"
msgstr "Optional: the server computes the signature for you, so any other parameter can be passed freely; choose either this or custom_sign; if omitted, the platform .env value (PROXY_JULIANG_KEY) is used."

msgid "选填：自定义 JSON 文件绝对路径；默认使用平台配置路径。涉及服务器文件读写，非必要请勿传。"
msgstr "Optional: a custom absolute path to the JSON file; the platform-configured path is used by default. This involves server file read/write, so do not provide it unless necessary."

msgid "选填：账号密码认证模式，与 password 成对出现"
msgstr "Optional: username/password authentication mode, used together with password"

msgid "选填：账户 token，与 order 成对出现；不传则用平台 .env（PROXY_QY_APIKEY）"
msgstr "Optional: account token, used together with order; if omitted, the platform .env value (PROXY_QY_APIKEY) is used"

msgid "选填：过滤掉今天已提取过的 IP"
msgstr "Optional: filter out IPs already extracted today."

msgid "选填：返回条数，>=1，默认 1（需多个请调大）"
msgstr "Optional: number of items to return, >=1, Default 1 (increase it if you need more)"

msgid "选填：返回条数，必须为正整数，默认 10"
msgstr "Optional: number of items to return, must be a positive integer, Default 10"

msgid "选填：青雨订单号，与 apikey 成对出现；不传则用平台 .env（PROXY_QY_ORDER）"
msgstr "Optional: Qingyu order number, used together with apikey; if omitted, the platform .env value (PROXY_QY_ORDER) is used"

msgid "选填：默认 false（仅拼装）；true 时真实经代理发一次请求"
msgstr "Optional: Default false (assembly only); true sends one real request through the proxy"

msgid "选填：默认 false（仅拼装，不消耗流量）；true 时真实经代理发一次请求"
msgstr "Optional: Default false (assembly only, no traffic consumed); true sends one real request through the proxy"

msgid "选填：默认 true（验证并按速度排序）"
msgstr "Optional: Default true (verify and sort by speed)"

msgid "部分线路支持可用性验证（verify=true）：服务端会实际探测代理连通性并按响应速度排序返回，适合对稳定性要求高、又不介意多等一会儿的采集场景；关闭验证则直接返回原始提取结果，速度更快。"
msgstr "Some channels support availability checking (verify=true): the server actually probes each proxy and returns them sorted by response speed, which suits scraping workloads that value stability over latency. With verification off, the raw extraction result is returned faster."

msgid "重新从 JSON 文件加载代理列表（配置更新后调用）。"
msgstr "Reload the proxy list from the JSON file (call after configuration updates)."

msgid "重新加载静态代理"
msgstr "Reload Static Proxies"

msgid "附加列参数（city_name / ip_remain / auth_info 等）开启后，该 IP 的附加内容统一放在 extra 字段，不影响 ip / port 解析。"
msgstr "When extra-column options (city_name / ip_remain / auth_info, etc.) are enabled, the extra information of each IP is placed in the extra field and does not affect ip / port parsing."

msgid "青雨住宅长效代理"
msgstr "Qingyu Residential Long-Lived Proxy"

msgid "青雨动态代理"
msgstr "Qingyu Dynamic Proxy"

msgid "静态代理以 JSON 文件管理：查询 / 新增 / 按 ip:port 删除 / 重新加载。写操作会改动平台文件，请谨慎。"
msgstr "Static proxies are managed via a JSON file: query / add / delete by ip:port / reload. Write operations modify platform files, so proceed with caution."

msgid "验证可用性"
msgstr "Verify availability"


# ==================== API 文档内容 · 问题反馈 ====================
msgid "closed（已关闭）"
msgstr "closed (Closed)"

msgid "pending（待处理）"
msgstr "pending (Pending)"

msgid "processing（处理中）"
msgstr "processing (Processing)"

msgid "resolved（已解决）"
msgstr "resolved (Resolved)"

msgid "上级评论 ID"
msgstr "Parent comment ID"

msgid "二级评论列表"
msgstr "Replies List"

msgid "全部接口需项目签名。评论列表分页返回，避免海量评论一次性撑爆响应。"
msgstr "All endpoints require project signature authentication. Comment lists are paginated so a large thread cannot blow up a single response."

msgid "全部接口需项目签名；create/reply 额外校验用户登录 Token（反馈人身份以此为准）。同项目内所有用户可见全部反馈与评论。"
msgstr "All endpoints require the project signature; create/reply additionally verify the user's login Token (which determines the reporter's identity). Within the same project, all users can see all feedback and comments."

msgid "内容"
msgstr "Content"

msgid "单条反馈详情：一级评论分页返回，每条内嵌二级评论首页（默认 5 条）。"
msgstr "Single feedback detail: top-level comments are returned with pagination, and each embeds the first page of replies (5 by default)."

msgid "反馈 ID"
msgstr "Feedback ID"

msgid "反馈API,工单接口,用户反馈系统"
msgstr "Feedback API,Ticket API,User Feedback System"

msgid "反馈列表"
msgstr "Feedback List"

msgid "反馈标题"
msgstr "Feedback title"

msgid "反馈详情+评论树"
msgstr "Feedback Detail + Comment Tree"

