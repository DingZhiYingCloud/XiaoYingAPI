msgid "选填：留空使用阿里云默认方案"
msgstr "Optional: leave empty to use the Aliyun default scheme"

msgid "选填：须与发送验证码时一致，留空使用默认方案"
msgstr "Optional: must match the value used when sending the code; leave empty to use the default scheme"

msgid "选填：频控间隔，默认 60 秒（防短信轰炸）"
msgstr "Optional: rate limit interval, Default 60 seconds (anti SMS bombing)"

msgid "选填：验证码有效时长，默认 300 秒（5 分钟）"
msgstr "Optional: verification code validity period, Default 300 seconds (5 minutes)"

msgid "选填：默认 1（不区分大小写）"
msgstr "Optional: Default 1 (case-insensitive)"

