# ============================================================
# 小影 API 环境变量模板
#
# 用法：复制本文件为 .env 后按需填写（.env 不入库）。
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# 变量含义与必填说明见 README 第五章。
# ============================================================

# ---------------- 必填 ----------------

# Django 密钥；缺失则服务拒绝启动。
# 同时用于 app_secret 等凭据的密文派生，上线后不可再变更（变更即已加密数据无法解密）。
SECRET_KEY=

# 允许访问的域名，逗号分隔；缺省仅允许 127.0.0.1 / localhost。
#   本地开发：127.0.0.1,localhost 即可（不对外时也可临时用 *）
#   生产：必须显式填写真实域名，禁止使用 *（S-08）
#   要覆盖子域：用**前导点**写法，如 example.com,.example.com
#              （.example.com 同时覆盖主域与所有子域；写成 *.example.com 不生效，会 400）
# 本地与生产的完整差异对照见 BugAndRepair/Django部署上线操作手册.md 第七节。
ALLOWED_HOSTS=127.0.0.1,localhost

# 站点对外基础地址（scheme://host，不要带结尾斜杠），如 https://xiaoyingapi.com
# 用途：后台线程等「没有 request」的场景需要把站内相对地址拼成公网绝对地址。
# 目前只作为「问题反馈」送审附件的兜底：附件默认从本地读出后内联给审核模型
# （图片会先压到长边 1280 的 JPEG，视频超过 8MB 才需要公网地址）：
#   填了 → 超大视频也能送审（审核模型须勾选「支持视觉 / 支持视频理解」）
#   留空 → 只是超大视频被跳过，图片与小视频照常送审
XYAPI_SITE_URL=

# ---------------- 运行模式 ----------------

# 生产必须为 False
DEBUG=False

# 是否允许所有跨域来源，默认 False
CORS_ORIGIN_ALLOW_ALL=False

# 环境模式单一开关：
#   true  = 本地开发（独立 Cookie 名隔离多项目 + 不强制 HTTPS）
#   false = 生产（标准 Cookie 名 + 强制 HTTPS Cookie）
# 生产部署务必不设置或设为 false，否则安全 Cookie 不会开启。
XYAPI_COOKIE_ISOLATION=true

# ---------------- 官网 ----------------

# 官网「接入项目」中自动创建的应用名称，默认 小影API官网
XYAPI_WEB_APP_NAME=

# 「计算程序」模块的内容根目录，默认 项目根/CalculationProgram。
# 该目录下的文件会被前台 /programs/ 页面完整对外展示并提供下载，请勿放入密钥、Cookie 等敏感文件。
XYAPI_PROGRAMS_ROOT=

# 官网表单是否启用自研图形验证，默认 true；本地开发 / 自动化测试可设 false 整体跳过
CAPTCHA_SELF_ENABLED=true

# 自研图形验证码有效期（秒），默认 300
CAPTCHA_SELF_EXPIRE_SECONDS=300

# ---------------- 邮件（邮箱服务 / 邮箱注册） ----------------

# QQ 邮箱发件账号
QQ_MAIL_ACCOUNT=
# QQ 邮箱 SMTP 授权码
QQ_MAIL_AUTH_CODE=
# 邮箱验证方式，默认 both
EMAIL_VERIFY_MODE=both
# 邮箱验证码有效期（分钟），默认 30
EMAIL_VERIFY_EXPIRE_MINUTES=30
# 短信验证码有效期（分钟），默认 5
PHONE_VERIFY_EXPIRE_MINUTES=5

# ---------------- 阿里云（短信验证 / 图形认证） ----------------

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 以下两项仅供 /api/captcha_auth/aliyun/ 服务使用
CAPTCHA_APP_ID=
CAPTCHA_APP_KEY=

# ---------------- AI 服务 ----------------

# AI 厂商（上游地址、平台 API Key）与模型清单已改为在超管后台维护，不再由 .env 提供：
#   /console/ai/models/
# 平台 Key 以 AES-256-GCM 密文落库（密钥由 SECRET_KEY 派生）→ 备份 SECRET_KEY，
# 更换 SECRET_KEY 会导致已存 Key 无法解密、需到后台重新填写。
# 首次升级（迁移 0038）会自动把旧 .env 里的 DEEPSEEK_API_KEY / DEEPSEEK_API_URL 搬进表。

# ---------------- 验证码识别（超级鹰打码平台） ----------------

# 超级鹰账号（https://www.chaojiying.com/user/reg/ 注册，按题分计费，1 元 = 1000 题分）。
# 供 /api/chaojiying/ 服务使用；账号由本站统一持有，调用方不接触。请求时密码以 md5(pass2) 发送。
CHAOJIYING_USER=
CHAOJIYING_PASS=
# 软件ID / 软件KEY（用户中心-软件ID 处生成，成对出现；留空则不启用识别结果的 md5 防篡改校验）
CHAOJIYING_SOFT_ID=
CHAOJIYING_SOFT_KEY=

# ---------------- 代练通 ----------------

# 接口签名密钥（S-04 起由 .env 提供，不再硬编码）
DAILIAN_SIGN_KEY=

# 注：代练通账号的「登录凭据」在超管后台「账号管理」维护（platform=dlt），
#     建议存 JSON：{"user_id": "...", "token": "...", "uid": "USR...", "pay_pass": "支付密码"}
#     其中 pay_pass 供全自动「接单」使用（缺失则接单会失败）。

# ---------------- 代练搬单（代练通订单 → 代练丸子发单） ----------------

# 我们的 QQ 号：发单时填入代练丸子的账号/密码/角色名与联系方式，引导打手加好友后私下交接账号
ORDER_MIGRATION_QQ=
# 轮询间隔（秒），默认 20；「被接单」检测的最坏延迟即此值
ORDER_MIGRATION_INTERVAL=20
# 只搬运价格在 [MIN, MAX] 区间的代练通订单（元，留空 = 不限）
ORDER_MIGRATION_PRICE_MIN=
ORDER_MIGRATION_PRICE_MAX=

# ---------------- 代理 IP ----------------

# 巨量代理：业务编号 / API Key / 代理账密（调用方可传自己的覆盖）
PROXY_JULIANG_TRADE_NO=
PROXY_JULIANG_KEY=
PROXY_JULIANG_USERNAME=
PROXY_JULIANG_PASSWORD=
# 巨量代理提取接口地址：留空=直连官方；巨量仅向国内 IP 提供提取服务，
# 海外部署需指向国内中转（如 http://<国内IP>/juliang-relay）
PROXY_JULIANG_API_BASE=
# 51代理：账号三件套 + 套餐ID / 不限量套餐ID / 提取标识（调用方可整套传自己的覆盖；
# 控制台生成的提取链接里 uid / accessName / accessPassword / packid / pid / rid 一一对应）
# 提取走「不限量套餐」接口 /unlimitedip/getip，pid（不限量套餐ID）是该接口的必填参数
PROXY_51DAILI_UID=
PROXY_51DAILI_ACCESS_NAME=
PROXY_51DAILI_ACCESS_PASSWORD=
PROXY_51DAILI_PACKID=
PROXY_51DAILI_PID=
PROXY_51DAILI_RID=
# 51代理提取接口地址：留空=直连官方（该地址只允许平台侧配置，不下发给调用方）；
# 51代理只向国内 IP 提供提取服务，海外部署需指向国内中转（nginx 反代，路径与参数不变）
PROXY_51DAILI_API_BASE=

# 「国内中转出口」（部署见 scripts/hj_relay）—— 海角自动注册与代理 IP 服务共用：
# 51代理 的**节点本身**只在国内网络可达，海外服务器拿正确账密直连也是一律 TCP 超时
#（实测 0/5；同机巨量 4/5 可用），故由国内那台机器去连 51代理 再把数据回传。
# 留空则：控制台「出口」里的 relay 选项不可用，且 /api/ProxyIp/51daili/proxies
# 不再下发 `proxy`（中转形态）字段。
PROXY_RELAY_URL=
# 与中转机 hj_relay.env 的 HJ_RELAY_SECRET 保持一致（该值每次都放在代理的用户名里下发）
PROXY_RELAY_SECRET=
# 自动注册页「出口」下拉的默认选中项：direct / 51daili / juliang / relay
# （海外生产环境填 relay；本地直连 51代理 可用，留空即默认 51daili）
HAIJIAO_REGISTER_PROXY=

# ---------------- 音乐爬虫（仅调试用） ----------------

MUSIC_SITE=https://www.aat.cx

# ---------------- 影视爬虫（电影服务，按线路配置） ----------------

# 电影 - 555 线路缓存过期时间（分钟），缓存目录 cache/movies/movie_555/
# 媒体类（m3u8 播放地址等有时效的资源），默认 30 分钟
MOVIE_555_MEDIA_CACHE_TTL=30
# 数据类（片名 / 详情 / 简介 / 集数等固定信息），默认 1440 分钟（24 小时）
MOVIE_555_DATA_CACHE_TTL=1440

# ---------------- 短剧（红果线路 · 网页直出） ----------------

# 第 4 集及以后源站是 DRM 加密的 H.265，浏览器播不了（原生 / MSE / WebCodecs 实测都解不了），
# 故由服务端「按需解密 + 转 H.264」后出流：被点播过的集才转，产物落盘永久复用。
# 取加密直链要调 App 内部接口，该接口要 metasec 安全头，签名由项目自带的 unidbg 签名器生成
# （运行物在 scripts/hongguo_sign/，见其中 start_sign_service.bat 顶部说明）。
# 默认指向本机：需要签名时自动拉起该进程，无需单独启动。
# 若要指向其它机器上的签名服务，改成对应地址即可（此时不再自动拉起）。
HONGGUO_SIGN_URL=http://127.0.0.1:9099
# 签名服务运行物目录（含 jre/），默认 项目根/scripts/hongguo_sign
HONGGUO_SIGN_DIR=
# 覆盖拉起签名服务用的 java（需 JDK 17+）。
# 留空时依次尝试：项目内置 jre/bin/java（**注意：内置 jre 是 Windows 版，Linux 上不存在该文件**）
# → PATH 上的 java。因此 **Linux 服务器务必显式填写**，例如 /usr/bin/java，
# 否则 uwsgi 的干净 PATH 里很可能找不到 java（报「找不到可用的 Java」）。
HONGGUO_JAVA_BIN=
# ffmpeg 可执行文件（CENC 解密 + 转 H.264 都要用），默认使用 PATH 上的 ffmpeg
HONGGUO_FFMPEG_BIN=ffmpeg
# 网页直出：转码产物根目录，默认 缓存根/dramas/hongguo_stream（按需转、永久复用）
HONGGUO_STREAM_DIR=
# 网页直出：默认画质（= 输出宽度上限，短剧是竖屏 1080×1920，1080 即日常说的 1080p）。
# 可选 1080 / 720 / 540 / 480 / 360；请求方可用 play 接口的 q 参数按次覆盖。
# 默认 1080 = 源站最高档（不缩放）。注意改小会让竖屏宽度同步变小（如 720 → 宽 408px）。
HONGGUO_STREAM_QUALITY=1080
# 网页直出：优先尝试的硬件编码器（按顺序探测，都不可用则回退 libx264），默认 nvenc→qsv→amf
HONGGUO_STREAM_HW_ENCODERS=h264_nvenc,h264_qsv,h264_amf
# 网页直出：软件编码兜底 preset / 质量，默认 veryfast + crf 20
HONGGUO_STREAM_X264_PRESET=veryfast
HONGGUO_STREAM_X264_CRF=20
# 网页直出：各画质档的码率上限（kbps）在 SpiderServices/dramas/hongguo/transcode.py
# 的 _RATE_BY_WIDTH 里按档位分别设定（改那张表即调画质），此处不提供总开关。
# 网页直出：播放地址时效令牌有效期（秒），默认 2 小时
HONGGUO_STREAM_TOKEN_TTL=7200

# ---------------- 海角社区 ----------------

# 数据缓存过期时间（分钟），默认 60
HAIJIAO_DATA_CACHE_TTL=60
# 视频播放列表缓存过期时间（分钟），默认 30
HAIJIAO_MEDIA_CACHE_TTL=30
# 今日域名缓存过期时间（分钟），默认 30
# 大陆可访问域名每日变动，爬虫据此自动跟随；缓存期内不再探测源站配置接口
HAIJIAO_DOMAIN_CACHE_TTL=30
# 默认登录凭据（x-user-id / x-user-token）：用于取帖内视频等需登录态的内容；
# 调用方可用请求参数 user_id / user_token 覆盖为自己的账号；留空则匿名请求。
HAIJIAO_USER_ID=
HAIJIAO_USER_TOKEN=
# node 可执行文件路径：生成视频播放列表时要调 `node derive_key.js` 还原真密钥。
# 留空 = 用 PATH 里的 node；Linux 服务器需自行安装 Node.js（脚本无 npm 依赖，装个
# node 二进制即可），装在非默认位置（如 /usr/local/bin/node）时在此填绝对路径。
# 注意：没装 node 时报的是 `[Errno 13] Permission denied: 'node'`，那不是权限问题。
HAIJIAO_NODE_BIN=
