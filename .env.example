# ============================================================
# 小影 API 环境变量模板
#
# 用法：复制本文件为 .env 后按需填写（.env 不入库）。
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# 变量含义与必填说明见 README 第五章。
# ============================================================

# ---------------- 必填 ----------------

# Django 密钥；缺失则服务拒绝启动。
# 同时用于 app_secret 等凭据的密文派生，上线后不可再变更（变更即已加密数据无法解密）。
SECRET_KEY=

# 允许访问的域名，逗号分隔；缺省仅允许 127.0.0.1 / localhost。
#   本地开发：127.0.0.1,localhost 即可（不对外时也可临时用 *）
#   生产：必须显式填写真实域名，禁止使用 *（S-08）
#   要覆盖子域：用**前导点**写法，如 example.com,.example.com
#              （.example.com 同时覆盖主域与所有子域；写成 *.example.com 不生效，会 400）
# 本地与生产的完整差异对照见 BugAndRepair/Django部署上线操作手册.md 第七节。
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------- 运行模式 ----------------

# 生产必须为 False
DEBUG=False

# 是否允许所有跨域来源，默认 False
CORS_ORIGIN_ALLOW_ALL=False

# 环境模式单一开关：
#   true  = 本地开发（独立 Cookie 名隔离多项目 + 不强制 HTTPS）
#   false = 生产（标准 Cookie 名 + 强制 HTTPS Cookie）
# 生产部署务必不设置或设为 false，否则安全 Cookie 不会开启。
XYAPI_COOKIE_ISOLATION=true

# ---------------- 官网 ----------------

# 官网「接入项目」中自动创建的应用名称，默认 小影API官网
XYAPI_WEB_APP_NAME=

# 「计算程序」模块的内容根目录，默认 项目根/CalculationProgram。
# 该目录下的文件会被前台 /programs/ 页面完整对外展示并提供下载，请勿放入密钥、Cookie 等敏感文件。
XYAPI_PROGRAMS_ROOT=

# 官网表单是否启用自研图形验证，默认 true；本地开发 / 自动化测试可设 false 整体跳过
CAPTCHA_SELF_ENABLED=true

# 自研图形验证码有效期（秒），默认 300
CAPTCHA_SELF_EXPIRE_SECONDS=300

# ---------------- 邮件（邮箱服务 / 邮箱注册） ----------------

# QQ 邮箱发件账号
QQ_MAIL_ACCOUNT=
# QQ 邮箱 SMTP 授权码
QQ_MAIL_AUTH_CODE=
# 邮箱验证方式，默认 both
EMAIL_VERIFY_MODE=both
# 邮箱验证码有效期（分钟），默认 30
EMAIL_VERIFY_EXPIRE_MINUTES=30
# 短信验证码有效期（分钟），默认 5
PHONE_VERIFY_EXPIRE_MINUTES=5

# ---------------- 阿里云（短信验证 / 图形认证） ----------------

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 以下两项仅供 /api/captcha_auth/aliyun/ 服务使用
CAPTCHA_APP_ID=
CAPTCHA_APP_KEY=

# ---------------- AI 服务 ----------------

# AI 厂商（上游地址、平台 API Key）与模型清单已改为在超管后台维护，不再由 .env 提供：
#   /console/ai/models/
# 平台 Key 以 AES-256-GCM 密文落库（密钥由 SECRET_KEY 派生）→ 备份 SECRET_KEY，
# 更换 SECRET_KEY 会导致已存 Key 无法解密、需到后台重新填写。
# 首次升级（迁移 0038）会自动把旧 .env 里的 DEEPSEEK_API_KEY / DEEPSEEK_API_URL 搬进表。

# ---------------- 代练通 ----------------

# 接口签名密钥（S-04 起由 .env 提供，不再硬编码）
DAILIAN_SIGN_KEY=

# ---------------- 代理 IP ----------------

# 静态代理 IP JSON 文件路径，默认 SpiderServices/ProxyIp/ProxyIP_Static/proxies.json
PROXY_STATIC_JSON_PATH=
# 91HTTP：平台交易号 / 平台密钥
PROXY_91HTTP_TRADE_NO=
PROXY_91HTTP_SECRET=
# 青雨：平台订单号 / apikey（调用方可传自己的 order/apikey 覆盖）
PROXY_QY_ORDER=
PROXY_QY_APIKEY=
# 青雨住宅长效：提取到的节点连接信息（主机 / 端口 / 账号 / 密码；节点会到期，需及时更新）
PROXY_QY_RES_HOST=
PROXY_QY_RES_PORT=
PROXY_QY_RES_USERNAME=
PROXY_QY_RES_PASSWORD=
# Thordata 动态住宅代理：网关主机 / 端口 / 账号 / 密码（调用方可传参覆盖）
PROXY_THORDATA_HOST=
PROXY_THORDATA_PORT=
PROXY_THORDATA_USERNAME=
PROXY_THORDATA_PASSWORD=
# 巨量代理：业务编号 / API Key / 代理账密（调用方可传自己的覆盖）
PROXY_JULIANG_TRADE_NO=
PROXY_JULIANG_KEY=
PROXY_JULIANG_USERNAME=
PROXY_JULIANG_PASSWORD=
# 巨量代理提取接口地址：留空=直连官方；巨量仅向国内 IP 提供提取服务，
# 海外部署需指向国内中转（如 http://<国内IP>/juliang-relay）
PROXY_JULIANG_API_BASE=

# ---------------- 音乐爬虫（仅调试用） ----------------

MUSIC_SITE=https://www.aat.cx

# ---------------- 影视爬虫（电影服务，按线路配置） ----------------

# 电影 - 555 线路缓存过期时间（分钟），缓存目录 cache/movies/movie_555/
# 媒体类（m3u8 播放地址等有时效的资源），默认 30 分钟
MOVIE_555_MEDIA_CACHE_TTL=30
# 数据类（片名 / 详情 / 简介 / 集数等固定信息），默认 1440 分钟（24 小时）
MOVIE_555_DATA_CACHE_TTL=1440

# ---------------- 短剧（红果线路 · 预处理） ----------------

# 第 4 集及以后源站是 DRM 加密的 H.265，浏览器播不了，故改用
# 「预处理 → 上传外部平台 → 登记链接」的方式：
#     python manage.py hongguo_preprocess --series <剧集ID> [--episodes 4-222]
# 解密需调 App 内部接口取流，该接口要 metasec 安全头，签名由项目自带的 unidbg 签名器生成
# （运行物在 scripts/hongguo_sign/，见其中 start_sign_service.bat 顶部说明）。
# 默认指向本机：需要签名时自动拉起该进程，无需单独启动。
# 若要指向其它机器上的签名服务，改成对应地址即可（此时不再自动拉起）。
HONGGUO_SIGN_URL=http://127.0.0.1:9099
# 签名服务运行物目录（含 jre/），默认 项目根/scripts/hongguo_sign
HONGGUO_SIGN_DIR=
# 覆盖拉起签名服务用的 java（需 JDK 17+）；留空则优先用项目内置 jre/，其次 PATH 上的 java
HONGGUO_JAVA_BIN=
# 预处理产物根目录，默认 缓存根/dramas/hongguo_preprocess（每部剧一个 `{剧名}_{剧集ID}` 子目录）
HONGGUO_PREPROCESS_DIR=
# 预处理期望清晰度，默认 1080；填 0 表示自动取最高可解清晰度
HONGGUO_PREPROCESS_HEIGHT=1080
# ffmpeg 可执行文件（CENC 解密必需），默认使用 PATH 上的 ffmpeg
HONGGUO_FFMPEG_BIN=ffmpeg
# 网页直出：转码产物根目录，默认 缓存根/dramas/hongguo_stream（按需转、永久复用）
HONGGUO_STREAM_DIR=
# 网页直出：默认画质（= 输出宽度上限，短剧是竖屏 1080×1920，1080 即日常说的 1080p）。
# 可选 1080 / 720 / 540 / 480 / 360；请求方可用 play 接口的 q 参数按次覆盖。
# 默认 1080 = 源站最高档（不缩放）。注意改小会让竖屏宽度同步变小（如 720 → 宽 408px）。
HONGGUO_STREAM_QUALITY=1080
# 网页直出：优先尝试的硬件编码器（按顺序探测，都不可用则回退 libx264），默认 nvenc→qsv→amf
HONGGUO_STREAM_HW_ENCODERS=h264_nvenc,h264_qsv,h264_amf
# 网页直出：软件编码兜底 preset / 质量，默认 veryfast + crf 20
HONGGUO_STREAM_X264_PRESET=veryfast
HONGGUO_STREAM_X264_CRF=20
# 网页直出：各画质档的码率上限（kbps）在 SpiderServices/dramas/hongguo/transcode.py
# 的 _RATE_BY_WIDTH 里按档位分别设定（改那张表即调画质），此处不提供总开关。
# 网页直出：播放地址时效令牌有效期（秒），默认 2 小时
HONGGUO_STREAM_TOKEN_TTL=7200

# ---------------- 海角社区 ----------------

# 数据缓存过期时间（分钟），默认 60
HAIJIAO_DATA_CACHE_TTL=60
# 视频播放列表缓存过期时间（分钟），默认 30
HAIJIAO_MEDIA_CACHE_TTL=30
# 默认登录凭据（x-user-id / x-user-token）：用于取帖内视频等需登录态的内容；
# 调用方可用请求参数 user_id / user_token 覆盖为自己的账号；留空则匿名请求。
HAIJIAO_USER_ID=
HAIJIAO_USER_TOKEN=
