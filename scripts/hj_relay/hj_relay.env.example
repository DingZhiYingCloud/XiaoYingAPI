# 海角自动注册 —— 国内中转出口（hj_relay.py）配置模板
# 用法：复制为同目录的 hj_relay.env，填好后 chmod 600 hj_relay.env
# 注意：hj_relay.env 含明文凭据与密钥，必须 600，且不要提交进仓库。

# ---------- 本服务 ----------
# 监听地址（本机防火墙/安全组只需对生产服务器放行该端口；本服务自身还会再校验一次来源 IP）
HJ_RELAY_LISTEN=0.0.0.0:17890
# 允许的来源 IP，逗号分隔。默认只放行生产服务器；留空会拒绝启动
HJ_RELAY_ALLOW_IPS=192.253.235.28
# 共享密钥，客户端放在 Proxy-Authorization 里。生成方式：
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
HJ_RELAY_SECRET=
# 同一条 51代理 出口的粘性时长（秒）：
# 至少要覆盖「取注册验证码 → 超级鹰打码 → 提交注册」的间隔，否则两次请求会换 IP，
# 源站按 captchaId 校验出口就会把验证码图 302 掉。
HJ_RELAY_UPSTREAM_TTL=600
# 连「51代理 出口」与「海角」的超时（秒）
HJ_RELAY_CONNECT_TIMEOUT=20
# 调 51代理 提取接口的超时（秒）
HJ_RELAY_EXTRACT_TIMEOUT=15

# ---------- 51代理（键名与项目 .env 同名同义，五项必须与生产服务器一致） ----------
# 提取接口地址：本服务已在国内，直连官方即可（海外才需要指向国内中转）
PROXY_51DAILI_API_BASE=http://bapi.51daili.com
PROXY_51DAILI_UID=
PROXY_51DAILI_ACCESS_NAME=
PROXY_51DAILI_ACCESS_PASSWORD=
PROXY_51DAILI_PACKID=
# 不限量套餐 ID（提取接口 /unlimitedip/getip 的必填参数）
PROXY_51DAILI_PID=
PROXY_51DAILI_RID=
