{
  "name": "目标检测",
  "type": "http",
  "method": "post",
  "path": "/api/ddddocr/detect",
  "status": "developing",
  "folderId": 90674351,
  "description": "## 功能说明\n\n检测图片中的目标位置，返回各目标的四个顶点坐标与置信度。\n\n## 安全说明（S-01 整改）\n\n图片仅接受三类输入：上传的文件 bytes、http(s) 图片 URL、base64 字符串。\n- URL 带 SSRF 防护：仅公网 http/https；域名解析后命中内网 / 回环 / 链路本地 / 保留地址段即拒绝；不跟随重定向；限时 5 秒、限 10MB。\n- 本地文件路径仅允许读取服务器 `captcha_samples` 调试目录内的图片（realpath 前缀校验）。\n\n文件字段与 URL/base64 字段至少提供一个；同时提供时文件优先。\n\n## 鉴权（A-01）\n\n本接口需要签名认证 —— 须携带签名公共参数 `app_id / timestamp / nonce / sign`，未签名或签名错误返回 20011。\n\n## 请求方式\n\n- 上传文件时请求体为 multipart/form-data",
  "requestBody": {
    "type": "multipart/form-data",
    "parameters": [
      {
        "id": "image#0",
        "name": "image",
        "required": false,
        "description": "上传本地图片文件（与 image_url 至少提供一个，同时提供时文件优先）",
        "type": "file",
        "example": ""
      },
      {
        "id": "image_url#1",
        "name": "image_url",
        "required": false,
        "description": "或填写图片 URL / base64 字符串",
        "type": "string",
        "example": "https://example.com/captcha.png"
      },
      {
        "id": "app_id#2",
        "name": "app_id",
        "required": true,
        "description": "接入项目 APPID（app_ 前缀，公开标识）",
        "type": "string",
        "example": "app_5f3a9c2b7e6d8f1a2b3c4d5e6f7a8b9c"
      },
      {
        "id": "timestamp#3",
        "name": "timestamp",
        "required": true,
        "description": "10 位时间戳（秒），与服务器时间差须在 ±5 分钟内，防重放",
        "type": "string",
        "example": "1725000000"
      },
      {
        "id": "nonce#4",
        "name": "nonce",
        "required": true,
        "description": "随机字符串，每次请求唯一",
        "type": "string",
        "example": "a1b2c3d4e5f6a7b8"
      },
      {
        "id": "sign#5",
        "name": "sign",
        "required": true,
        "description": "HMAC-SHA256 签名（小写 hex），密钥为项目 app_secret",
        "type": "string",
        "example": "3f9a7c1e...（64 位小写 hex）"
      }
    ]
  },
  "responses": [
    {
      "id": "0",
      "name": "检测成功",
      "code": 200,
      "contentType": "json",
      "description": "返回各目标的边界框与置信度",
      "jsonSchema": {
        "type": "object",
        "required": ["code", "msg", "data"],
        "properties": {
          "code": { "type": "integer", "description": "10000=成功" },
          "msg": { "type": "string", "description": "检测成功" },
          "data": {
            "type": "array",
            "description": "检测到的目标列表",
            "items": {
              "type": "object",
              "required": ["box", "score"],
              "properties": {
                "box": {
                  "type": "array",
                  "description": "四个顶点坐标 [[x1,y1],[x2,y2],[x3,y3],[x4,y4]]",
                  "items": { "type": "array", "items": { "type": "integer" } }
                },
                "score": { "type": "number", "description": "置信度分数" }
              }
            }
          }
        }
      }
    },
    {
      "id": "1",
      "name": "参数缺失",
      "code": 200,
      "contentType": "json",
      "description": "未提供图片（文件与 URL/base64 都为空）",
      "jsonSchema": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "20001 参数缺失" },
          "msg": { "type": "string", "description": "参数缺失: image(图片文件/URL/base64)" },
          "data": { "type": "null" }
        }
      }
    },
    {
      "id": "2",
      "name": "识别失败",
      "code": 200,
      "contentType": "json",
      "description": "图片无法读取 / URL 被安全策略拒绝 / 模型识别异常",
      "jsonSchema": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "40001 外部API调用失败" },
          "msg": { "type": "string", "description": "具体错误信息" },
          "data": { "type": "null" }
        }
      }
    }
  ],
  "responseExamples": [
    {
      "name": "检测成功示例",
      "responseId": "0",
      "data": "{\n  \"code\": 10000,\n  \"msg\": \"检测成功\",\n  \"data\": [\n    {\n      \"box\": [[12, 20], [96, 20], [96, 54], [12, 54]],\n      \"score\": 0.99\n    }\n  ]\n}"
    }
  ]
}
