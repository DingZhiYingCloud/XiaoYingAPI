{
  "name": "查询单个接口调用量",
  "type": "http",
  "method": "get",
  "path": "/api/statistics/api_calls",
  "status": "released",
  "folderId": 95704840,
  "description": "## 功能说明\n\n查询文档中心某个已登记接口的**累计调用次数**与**今日调用次数**（公开口径）。\n\n- 数据由请求日志中间件顺带采集，**按天预聚合**入库，写入最多延迟数秒\n- 统计范围仅 `/api/` 业务接口；认证被拒（20011）与未匹配路由同样计入\n- 公开口径**只含调用次数**，不含项目、失败率与耗时（那些仅在超管看板 `/console/stats/` 可见）\n\n## 鉴权\n\n本服务为**开放接口**（分类树 `/api/statistics/` 设为 open），无需项目签名。\n\n## 请求方式\n\n- GET，参数放 query string",
  "parameters": {
    "query": [
      {
        "id": "path#0",
        "name": "path",
        "required": true,
        "description": "接口路径，须为文档中心已登记的路径；带路径参数的接口按文档写法传占位符，如 /api/music/xiaoying/musics/<uuid>",
        "type": "string",
        "example": "/api/email/v1/send"
      }
    ]
  },
  "responses": [
    {
      "id": "0",
      "name": "查询成功",
      "code": 200,
      "contentType": "json",
      "description": "返回该接口的累计与今日调用次数",
      "jsonSchema": {
        "type": "object",
        "required": ["code", "msg", "data"],
        "properties": {
          "code": { "type": "integer", "description": "10000=成功" },
          "msg": { "type": "string", "description": "查询成功" },
          "data": {
            "type": "object",
            "required": ["path", "total_calls", "today_calls"],
            "properties": {
              "path": { "type": "string", "description": "查询的接口路径" },
              "total_calls": { "type": "integer", "description": "累计调用次数" },
              "today_calls": { "type": "integer", "description": "今日调用次数" }
            }
          }
        }
      }
    },
    {
      "id": "1",
      "name": "参数缺失",
      "code": 200,
      "contentType": "json",
      "description": "未传 path",
      "jsonSchema": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "20001 参数缺失" },
          "msg": { "type": "string", "description": "参数缺失: path" },
          "data": { "type": "null" }
        }
      }
    },
    {
      "id": "2",
      "name": "参数值非法",
      "code": 200,
      "contentType": "json",
      "description": "path 不是文档中心已登记的接口路径",
      "jsonSchema": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "20003 参数值非法" },
          "msg": { "type": "string", "description": "参数值非法: path 不是文档中心已登记的接口路径" },
          "data": { "type": "null" }
        }
      }
    }
  ],
  "responseExamples": [
    {
      "name": "查询成功示例",
      "responseId": "0",
      "data": "{\n  \"code\": 10000,\n  \"msg\": \"查询成功\",\n  \"data\": {\n    \"path\": \"/api/email/v1/send\",\n    \"total_calls\": 1280,\n    \"today_calls\": 36\n  }\n}"
    }
  ]
}
