{
  "name": "发布抖音评论",
  "type": "http",
  "method": "post",
  "path": "/api/douyin/comment/publish",
  "status": "released",
  "folderId": 95704865,
  "description": "## 功能说明\n\n在指定抖音视频下发布一条**一级纯文本评论**，返回评论 ID、内容与发布时间。原「自动评论」服务的能力已迁移至此。\n\n- 签名的 `a_bogus` 与 `x-tt-session-dtrait` 均由**本地补环境执行抖音官方 JS** 生成，不依赖浏览器\n- 该线路**需要服务器安装 Node.js ≥ 18**（用到全局 `fetch` 与 Web Crypto）\n\n## 使用约束\n\n- 需准备**真实抖音登录 Cookie**，且该账号有权限评论目标视频（视频需存在且公开）\n- Cookie 仅透传给抖音，服务端不落盘；Cookie 失效会返回外部服务错误\n- 抖音风控严格：高频调用会导致账号被限流，请**低频调用并对失败做退避**\n- 当前仅支持一级纯文本评论，不支持 @ / 话题 / 图片\n- 被风控拦截时抖音返回空响应，此处统一映射为「外部API调用失败」\n\n## 签名机制\n\n调用本接口必须携带签名公共参数（`app_id` / `timestamp` / `nonce` / `sign`），算法与其它需认证接口一致：除 `sign` 外所有参数按键名 ASCII 升序拼为 `k=v&k=v...`，以 `app_secret` 为密钥做 HMAC-SHA256，输出小写 hex。\n\n## 请求方式\n\n- 表单提交（application/x-www-form-urlencoded）：参数放表单字段，不要放 URL 查询串\n- 不支持 GET 方法（返回 405）",
  "requestBody": {
    "type": "application/x-www-form-urlencoded",
    "parameters": [
      {
        "id": "cookie#0",
        "name": "cookie",
        "required": true,
        "description": "抖音登录 Cookie 完整字符串（浏览器登录抖音后从开发者工具「网络」面板复制，含 sessionid 等）",
        "type": "text",
        "example": "sessionid=xxx; passport_csrf_token=yyy; ..."
      },
      {
        "id": "aweme_id#1",
        "name": "aweme_id",
        "required": true,
        "description": "目标视频 ID（纯数字，取自视频页 URL 的 /video/<aweme_id> 部分）",
        "type": "string",
        "example": "7622798120358923583"
      },
      {
        "id": "text#2",
        "name": "text",
        "required": true,
        "description": "评论内容（一级纯文本评论）",
        "type": "text",
        "example": "一级纯文本评论内容"
      },
      {
        "id": "app_id#3",
        "name": "app_id",
        "required": true,
        "description": "接入项目 APPID（app_ 前缀，公开标识）",
        "type": "string",
        "example": "app_5f3a9c2b7e6d8f1a2b3c4d5e6f7a8b9c"
      },
      {
        "id": "timestamp#4",
        "name": "timestamp",
        "required": true,
        "description": "10 位时间戳（秒），与服务器时间差须在 ±5 分钟内，防重放",
        "type": "string",
        "example": "1725000000"
      },
      {
        "id": "nonce#5",
        "name": "nonce",
        "required": true,
        "description": "随机字符串，每次请求唯一",
        "type": "string",
        "example": "a1b2c3d4e5f6a7b8"
      },
      {
        "id": "sign#6",
        "name": "sign",
        "required": true,
        "description": "HMAC-SHA256 签名（小写 hex），密钥为项目 app_secret",
        "type": "string",
        "example": "3f9a7c1e...（64 位小写 hex）"
      }
    ]
  },
  "responses": [
    {
      "id": "0",
      "name": "发布成功",
      "code": 200,
      "contentType": "json",
      "description": "评论已发布",
      "jsonSchema": {
        "type": "object",
        "required": ["code", "msg", "data"],
        "properties": {
          "code": { "type": "integer", "description": "10000=成功" },
          "msg": { "type": "string", "description": "成功" },
          "data": {
            "type": "object",
            "required": ["cid", "text", "create_time"],
            "properties": {
              "cid": { "type": "string", "description": "评论 ID" },
              "text": { "type": "string", "description": "评论内容" },
              "create_time": { "type": "integer", "description": "发布时间（秒级时间戳）" }
            }
          }
        }
      }
    },
    {
      "id": "1",
      "name": "参数缺失",
      "code": 200,
      "contentType": "json",
      "description": "缺少 cookie / aweme_id / text 或签名参数",
      "jsonSchema": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "20001 参数缺失" },
          "msg": { "type": "string", "description": "如：参数缺失: cookie, text" },
          "data": { "type": "null" }
        }
      }
    },
    {
      "id": "2",
      "name": "参数格式错误",
      "code": 200,
      "contentType": "json",
      "description": "aweme_id 不是纯数字视频ID",
      "jsonSchema": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "20002 参数格式错误" },
          "msg": { "type": "string", "description": "参数格式错误: aweme_id 必须为纯数字视频ID" },
          "data": { "type": "null" }
        }
      }
    },
    {
      "id": "3",
      "name": "签名校验失败",
      "code": 200,
      "contentType": "json",
      "description": "签名参数缺失 / 签名过期 / sign 不匹配 / app_id 未注册或已停用",
      "jsonSchema": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "20011 认证失败" },
          "msg": { "type": "string", "description": "签名相关错误提示" },
          "data": { "type": "null" }
        }
      }
    },
    {
      "id": "4",
      "name": "发布失败",
      "code": 200,
      "contentType": "json",
      "description": "Cookie 失效 / 被风控拦截 / 抖音返回异常",
      "jsonSchema": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "40001 外部API调用失败" },
          "msg": { "type": "string", "description": "具体错误信息" },
          "data": { "type": "null" }
        }
      }
    }
  ],
  "responseExamples": [
    {
      "name": "发布成功示例",
      "responseId": "0",
      "data": "{\n  \"code\": 10000,\n  \"msg\": \"成功\",\n  \"data\": {\n    \"cid\": \"7622798120358923583\",\n    \"text\": \"一级纯文本评论内容\",\n    \"create_time\": 1789200000\n  }\n}"
    }
  ]
}
