{
  "_usage": "全量 API 冒烟测试配置。base_url/app_id/app_secret 可留空（app 留空且本机可访问数据库时会自动创建临时项目）。vars 中留空的变量，依赖它的用例会被标记 SKIP，填好即可执行；支持 ${VarName} 引用 vars 或前序用例 save 的运行时变量。内置变量 ${RunId}（本次运行时间戳）用于生成唯一测试数据，可反复运行。",
  "base_url": "http://127.0.0.1:8000",
  "app_id": "",
  "app_secret": "",
  "timeout": 60,

  "vars_help": {
    "TestEmail": "用于「邮箱 v1 发信」的真实收件邮箱",
    "TestPhone": "用于短信验证的真实 11 位手机号",
    "SmsCode": "短信验证码（check 用例需要，与发送的 phone 对应）",
    "RegUsername": "用户中心注册/登录用账号（每次运行建议换一个，避免重复注册 20031）",
    "RegPassword": "用户中心密码（8-64 位，字母+数字混合）",
    "UserToken": "用户中心登录后的 Token（用于 info/logout/verify/feedback 等）",
    "MailcxEmailId": "mail.cx 邮件 id（从 emails 用例结果复制，用于详情用例）",
    "T2t58Keyword": "2t58 搜索关键词",
    "T2t58SingerUrl": "2t58 歌手页完整 URL（www.2t58.com 域名）",
    "T2t58SongUrl": "2t58 歌曲页完整 URL（www.2t58.com 域名）",
    "SpiderIp": "蜘蛛验证的 IP（默认 Google 爬虫段）",
    "StatisticsPath": "调用统计查询的接口路径",
    "AiContent": "AI 接口输入内容",
    "MovieVodId": "电影影片 ID（取自分类列表/搜索结果，用于详情与播放地址用例）",
    "MovieSid": "电影播放源序号（取自详情接口 sources[].sid）",
    "MovieNid": "电影集数序号（取自选集 episodes[].nid，电影通常为 1）",
    "MovieKeyword": "电影搜索关键词（片名，需为中文片名）",
    "DouyinShareText": "抖音分享文本/链接（视频解析）",
    "DouyinCookie": "抖音登录 Cookie（评论发布；真实账号，注意风控）",
    "DouyinAwemeId": "抖音视频 ID（纯数字）",
    "DddocrImage": "ddddocr 识别图片：URL 或 base64 字符串",
    "DddocrSlide": "滑块图片：URL 或 base64",
    "DddocrBg": "背景图片：URL 或 base64",
    "UploadImagePath": "本机图片文件绝对路径（上传图片用例）",
    "UploadVideoPath": "本机视频文件绝对路径（上传视频用例）",
    "UploadFilePath": "本机通用文件绝对路径（上传文件用例）",
    "PicuiTokenFilePath": "本机按行存放图床 Token 的文本文件绝对路径（picui Token 导入用例，一行一个 Token；已入库的 Token 会被自动跳过，不会重复写入）",
    "MusicImportPath": "音乐批量导入用的 JSON 文件绝对路径",
    "CaptchaSelfAnswer": "自研验证码答案（generate 返回图片，人工识别后填入）",
    "CaptchaAuthLotNumber": "阿里云图形认证 lot_number（前端 SDK 回调获取）",
    "CaptchaAuthOutput": "阿里云图形认证 captcha_output",
    "CaptchaAuthPassToken": "阿里云图形认证 pass_token",
    "CaptchaAuthGenTime": "阿里云图形认证 gen_time",
    "DltPhone": "代练通手机号",
    "DltCode": "代练通短信验证码",
    "DltUserId": "代练通 user_id（登录后获得）",
    "DltToken": "代练通 token（登录后获得）",
    "DltUid": "代练通 uid",
    "DltOrderId": "代练通订单号",
    "DltPayPass": "代练通支付密码",
    "DlwzPhone": "代练丸子手机号",
    "DlwzCode": "代练丸子短信验证码",
    "DlwzAuth": "代练丸子 authorization（登录后获得）",
    "DlwzOrderId": "代练丸子订单号"
  },

  "vars": {
    "TestEmail": "",
    "TestPhone": "",
    "SmsCode": "",
    "RegUsername": "",
    "RegPassword": "",
    "UserToken": "",
    "MailcxEmailId": "",
    "T2t58Keyword": "周杰伦",
    "T2t58SingerUrl": "https://www.2t58.com/singer/bm1z/1.html",
    "T2t58SongUrl": "https://www.2t58.com/song/d3dkc2t3.html",
    "SpiderIp": "66.249.65.205",
    "StatisticsPath": "/api/statistics/services",
    "AiContent": "你好",
    "MovieVodId": "571810",
    "MovieSid": "1",
    "MovieNid": "1",
    "MovieKeyword": "流浪地球",
    "DouyinShareText": "",
    "DouyinCookie": "",
    "DouyinAwemeId": "",
    "DddocrImage": "",
    "DddocrSlide": "",
    "DddocrBg": "",
    "UploadImagePath": "",
    "UploadVideoPath": "",
    "UploadFilePath": "",
    "PicuiTokenFilePath": "",
    "MusicImportPath": "",
    "CaptchaSelfAnswer": "",
    "CaptchaAuthLotNumber": "",
    "CaptchaAuthOutput": "",
    "CaptchaAuthPassToken": "",
    "CaptchaAuthGenTime": "",
    "DltPhone": "",
    "DltCode": "",
    "DltUserId": "",
    "DltToken": "",
    "DltUid": "",
    "DltOrderId": "",
    "DltPayPass": "",
    "DlwzPhone": "",
    "DlwzCode": "",
    "DlwzAuth": "",
    "DlwzOrderId": ""
  },

  "cases": [
    {"name": "用户中心-可用登录方式(公开GET)", "method": "GET", "path": "/api/user_center/users/methods"},
    {"name": "用户中心-项目信息", "method": "GET", "path": "/api/user_center/projects/info"},
    {"name": "用户中心-注册(用户名+密码)", "method": "POST", "path": "/api/user_center/users/register",
     "params": {"username": "${RegUsername}", "password": "${RegPassword}"}, "expect": [10000, 20031]},
    {"name": "用户中心-登录(账号+密码)", "method": "POST", "path": "/api/user_center/users/login",
     "params": {"account": "${RegUsername}", "password": "${RegPassword}"}, "save": {"UserToken": "data.token"}},
    {"name": "用户中心-登录验证码发送", "method": "POST", "path": "/api/user_center/users/login/send",
     "params": {"email": "${TestEmail}"}},
    {"name": "用户中心-重置密码验证码发送", "method": "POST", "path": "/api/user_center/users/password/send",
     "params": {"email": "${TestEmail}"}},
    {"name": "用户中心-重置密码", "method": "POST", "path": "/api/user_center/users/password/reset",
     "params": {"email": "${TestEmail}", "code": "${SmsCode}", "password": "${RegPassword}"}},
    {"name": "用户中心-用户信息", "method": "GET", "path": "/api/user_center/users/info",
     "params": {"token": "${UserToken}"}},
    {"name": "用户中心-验证Token", "method": "POST", "path": "/api/user_center/users/verify",
     "params": {"token": "${UserToken}"}},
    {"name": "用户中心-退出登录", "method": "POST", "path": "/api/user_center/users/logout",
     "params": {"token": "${UserToken}"}},
    {"name": "用户中心-邮箱激活链接(公开GET)", "method": "GET", "path": "/api/user_center/users/verify/email",
     "params": {"token": "invalid-token-demo"}, "expect_html": true},
    {"name": "用户中心-邮箱验证码完成注册", "method": "POST", "path": "/api/user_center/users/verify/email",
     "params": {"email": "${TestEmail}", "code": "${SmsCode}"}},
    {"name": "用户中心-重发注册邮箱验证", "method": "POST", "path": "/api/user_center/users/verify/email/resend",
     "params": {"email": "${TestEmail}"}},
    {"name": "用户中心-手机号验证码完成注册", "method": "POST", "path": "/api/user_center/users/verify/phone",
     "params": {"phone": "${TestPhone}", "code": "${SmsCode}"}},
    {"name": "用户中心-发送注册手机验证码", "method": "POST", "path": "/api/user_center/users/verify/phone/send",
     "params": {"phone": "${TestPhone}"}},

    {"name": "短信验证-发送验证码", "method": "POST", "path": "/api/sms_verify/aliyun/send",
     "params": {"phone": "${TestPhone}", "code_length": "4", "return_verify_code": "true"}},
    {"name": "短信验证-核验验证码", "method": "POST", "path": "/api/sms_verify/aliyun/check",
     "params": {"phone": "${TestPhone}", "verify_code": "${SmsCode}"}},
    {"name": "图形认证-配置(公开GET)", "method": "GET", "path": "/api/captcha_auth/aliyun/config"},
    {"name": "图形认证-二次校验", "method": "POST", "path": "/api/captcha_auth/aliyun/verify",
     "params": {"lot_number": "${CaptchaAuthLotNumber}", "captcha_output": "${CaptchaAuthOutput}",
                "pass_token": "${CaptchaAuthPassToken}", "gen_time": "${CaptchaAuthGenTime}"}},
    {"name": "自研验证码-生成(公开GET)", "method": "GET", "path": "/api/captcha_self/generate",
     "params": {"kind": "char", "length": "4"}, "save": {"CaptchaId": "data.captcha_id"}},
    {"name": "自研验证码-校验", "method": "POST", "path": "/api/captcha_self/verify",
     "params": {"captcha_id": "${CaptchaId}", "answer": "${CaptchaSelfAnswer}"}, "expect": [10000, 20003]},

    {"name": "邮箱-虚拟邮箱(minmail)生成", "method": "POST", "path": "/api/email/VMEmail/minmail/generate",
     "save": {"VisitorId": "data.visitor_id"}},
    {"name": "邮箱-虚拟邮箱(minmail)邮件列表", "method": "GET", "path": "/api/email/VMEmail/minmail/emails",
     "params": {"visitor_id": "${VisitorId}"}},
    {"name": "邮箱-v1发送邮件", "method": "POST", "path": "/api/email/v1/send",
     "params": {"subject": "冒烟测试邮件", "body": "这是一封 API 冒烟测试邮件。", "recipients": "${TestEmail}"}},
    {"name": "邮箱-mail.cx可用域名", "method": "GET", "path": "/api/VMEmail_mailcx/domains"},
    {"name": "邮箱-mail.cx生成邮箱", "method": "POST", "path": "/api/VMEmail_mailcx/generate",
     "params": {"domain": "uqu.me"}, "save": {"MailcxAddress": "data.address", "MailcxClientId": "data.client_id"}},
    {"name": "邮箱-mail.cx邮件列表(长轮询)", "method": "GET", "path": "/api/VMEmail_mailcx/emails",
     "params": {"address": "${MailcxAddress}", "client_id": "${MailcxClientId}"}},
    {"name": "邮箱-mail.cx邮件详情", "method": "GET", "path": "/api/VMEmail_mailcx/email_detail",
     "params": {"email_id": "${MailcxEmailId}", "client_id": "${MailcxClientId}"}},

    {"name": "反馈-列表", "method": "GET", "path": "/api/feedback/list",
     "params": {"page": "1", "page_size": "10"}},
    {"name": "反馈-创建", "method": "POST", "path": "/api/feedback/create",
     "params": {"title": "冒烟测试反馈-${RunId}", "content": "冒烟测试内容", "token": "${UserToken}"},
     "save": {"FeedbackId": "data.feedback_id"}},
    {"name": "反馈-详情", "method": "GET", "path": "/api/feedback/detail",
     "params": {"feedback_id": "${FeedbackId}"}},
    {"name": "反馈-追加评论", "method": "POST", "path": "/api/feedback/reply",
     "params": {"feedback_id": "${FeedbackId}", "content": "冒烟测试回复", "token": "${UserToken}"}},
    {"name": "反馈-评论列表", "method": "GET", "path": "/api/feedback/replies",
     "params": {"feedback_id": "${FeedbackId}", "parent_id": "1"}},

    {"name": "音乐-2t58首页", "method": "GET", "path": "/api/music/2t58/home", "expect": [10000, 40001]},
    {"name": "音乐-2t58搜索", "method": "GET", "path": "/api/music/2t58/search",
     "params": {"keyword": "${T2t58Keyword}", "page": "1"}, "expect": [10000, 40001]},
    {"name": "音乐-2t58歌手详情", "method": "GET", "path": "/api/music/2t58/singer",
     "params": {"url": "${T2t58SingerUrl}"}, "expect": [10000, 40001]},
    {"name": "音乐-2t58歌曲详情", "method": "GET", "path": "/api/music/2t58/song",
     "params": {"url": "${T2t58SongUrl}"}, "expect": [10000, 40001]},
    {"name": "音乐-小影音乐列表", "method": "GET", "path": "/api/music/xiaoying/musics",
     "params": {"page": "1", "page_size": "10"}},
    {"name": "音乐-小影音乐创建", "method": "POST", "path": "/api/music/xiaoying/musics",
     "params": {"name": "冒烟测试音乐-${RunId}", "singer": "测试歌手"}, "save": {"MusicId": "data.id"}},
    {"name": "音乐-小影音乐详情", "method": "GET", "path": "/api/music/xiaoying/musics/<uuid>",
     "params": {"music_id": "${MusicId}"}},
    {"name": "音乐-小影音乐更新", "method": "PATCH", "path": "/api/music/xiaoying/musics/<uuid>",
     "params": {"music_id": "${MusicId}", "name": "冒烟测试音乐-改-${RunId}"}},
    {"name": "音乐-小影播放源创建", "method": "POST", "path": "/api/music/xiaoying/music_sources",
     "params": {"music_id": "${MusicId}", "url": "https://example.com/smoke.mp3"},
     "save": {"SourceId": "data.id"}},
    {"name": "音乐-小影播放源更新", "method": "PATCH", "path": "/api/music/xiaoying/music_sources/<uuid>",
     "params": {"source_id": "${SourceId}", "url": "https://example.com/smoke2.mp3"}},
    {"name": "音乐-小影播放源删除", "method": "DELETE", "path": "/api/music/xiaoying/music_sources/<uuid>",
     "params": {"source_id": "${SourceId}"}},
    {"name": "音乐-小影音乐删除", "method": "DELETE", "path": "/api/music/xiaoying/musics/<uuid>",
     "params": {"music_id": "${MusicId}"}},
    {"name": "音乐-小影批量导入", "method": "POST", "path": "/api/music/xiaoying/import",
     "files": {"file": "${MusicImportPath}"}},
    {"name": "音乐-小影批量导出(文件下载)", "method": "GET", "path": "/api/music/xiaoying/export", "file": true},

    {"name": "SEO-友情链接列表", "method": "GET", "path": "/api/seo/friend_links"},
    {"name": "SEO-友情链接创建", "method": "POST", "path": "/api/seo/friend_links",
     "params": {"name": "冒烟测试友链-${RunId}", "url": "https://example.com/smoke-${RunId}",
                "description": "冒烟测试", "category": "test"},
     "save": {"LinkId": "data.id"}},
    {"name": "SEO-友情链接详情", "method": "GET", "path": "/api/seo/friend_links/<int>",
     "params": {"link_id": "${LinkId}"}},
    {"name": "SEO-友情链接更新", "method": "PATCH", "path": "/api/seo/friend_links/<int>",
     "params": {"link_id": "${LinkId}", "description": "冒烟测试-改"}},
    {"name": "SEO-友情链接删除", "method": "DELETE", "path": "/api/seo/friend_links/<int>",
     "params": {"link_id": "${LinkId}"}},

    {"name": "上传-图片", "method": "POST", "path": "/api/upload/image", "files": {"file": "${UploadImagePath}"}},
    {"name": "上传-视频", "method": "POST", "path": "/api/upload/video", "files": {"file": "${UploadVideoPath}"}},
    {"name": "上传-文件", "method": "POST", "path": "/api/upload/file", "files": {"file": "${UploadFilePath}"}},
    {"name": "图床-scdn上传图片", "method": "POST", "path": "/api/ImageHosting/scdn/upload",
     "files": {"image": "${UploadImagePath}"}},
    {"name": "图床-picui上传图片", "method": "POST", "path": "/api/ImageHosting/picui/upload",
     "files": {"image": "${UploadImagePath}"}},
    {"name": "图床-picuiToken池查询", "method": "GET", "path": "/api/ImageHosting/picui/tokens"},
    {"name": "图床-picuiToken导入(按行文件)", "method": "POST", "path": "/api/ImageHosting/picui/tokens",
     "files": {"token_file": "${PicuiTokenFilePath}"}},

    {"name": "DDDDOCR-文字识别", "method": "POST", "path": "/api/ddddocr/ocr",
     "params": {"image": "${DddocrImage}"}, "expect": [10000, 40001]},
    {"name": "DDDDOCR-设置字符范围", "method": "POST", "path": "/api/ddddocr/set-ranges",
     "params": {"ranges": "0"}, "expect": [10000, 40001]},
    {"name": "DDDDOCR-目标检测", "method": "POST", "path": "/api/ddddocr/detect",
     "params": {"image": "${DddocrImage}"}, "expect": [10000, 40001]},
    {"name": "DDDDOCR-滑块匹配(边缘)", "method": "POST", "path": "/api/ddddocr/slide-match",
     "params": {"slide_image": "${DddocrSlide}", "bg_image": "${DddocrBg}"}, "expect": [10000, 40001]},
    {"name": "DDDDOCR-滑块匹配(差异)", "method": "POST", "path": "/api/ddddocr/slide-comparison",
     "params": {"slide_image": "${DddocrSlide}", "bg_image": "${DddocrBg}"}, "expect": [10000, 40001]},

    {"name": "AI-内置模型(deepseek)", "method": "POST", "path": "/api/ai/BuiltInModel/deepseek",
     "params": {"content": "${AiContent}"}, "expect": [10000, 40001]},

    {"name": "电影-分类列表", "method": "GET", "path": "/api/movies/movie_555/categories",
     "expect": [10000, 40001]},
    {"name": "电影-筛选条件(电影)", "method": "GET", "path": "/api/movies/movie_555/filters",
     "params": {"type_id": "1"}, "expect": [10000, 40001]},
    {"name": "电影-筛选条件-缺type_id", "method": "GET", "path": "/api/movies/movie_555/filters",
     "expect": [20001]},
    {"name": "电影-筛选条件-type_id非整数", "method": "GET", "path": "/api/movies/movie_555/filters",
     "params": {"type_id": "abc"}, "expect": [20002]},
    {"name": "电影-首页聚合", "method": "GET", "path": "/api/movies/movie_555/home",
     "expect": [10000, 40001]},
    {"name": "电影-分类列表(电影)", "method": "GET", "path": "/api/movies/movie_555/list",
     "params": {"type_id": "1"}, "expect": [10000, 40001]},
    {"name": "电影-分类列表-组合筛选", "method": "GET", "path": "/api/movies/movie_555/list",
     "params": {"type_id": "1", "area": "大陆", "genre": "动作", "lang": "国语",
                "year": "2025", "order": "time", "page": "2"},
     "expect": [10000, 40001]},
    {"name": "电影-分类列表-子分类(港台剧)", "method": "GET", "path": "/api/movies/movie_555/list",
     "params": {"type_id": "15"}, "expect": [10000, 40001]},
    {"name": "电影-分类列表-缺type_id", "method": "GET", "path": "/api/movies/movie_555/list",
     "expect": [20001]},
    {"name": "电影-分类列表-order非法", "method": "GET", "path": "/api/movies/movie_555/list",
     "params": {"type_id": "1", "order": "bad"}, "expect": [20003]},
    {"name": "电影-影片详情", "method": "GET", "path": "/api/movies/movie_555/detail",
     "params": {"vod_id": "${MovieVodId}"}, "expect": [10000, 40001]},
    {"name": "电影-播放地址", "method": "GET", "path": "/api/movies/movie_555/play",
     "params": {"vod_id": "${MovieVodId}", "sid": "${MovieSid}", "nid": "${MovieNid}"},
     "expect": [10000, 40001]},
    {"name": "电影-播放地址-缺sid", "method": "GET", "path": "/api/movies/movie_555/play",
     "params": {"vod_id": "${MovieVodId}", "nid": "1"}, "expect": [20001]},
    {"name": "电影-搜索", "method": "GET", "path": "/api/movies/movie_555/search",
     "params": {"keyword": "${MovieKeyword}"}, "expect": [10000, 40001]},
    {"name": "电影-搜索-缺keyword", "method": "GET", "path": "/api/movies/movie_555/search",
     "expect": [20001]},

    {"name": "代理IP-66免费", "method": "GET", "path": "/api/ProxyIp/66daili/proxies",
     "params": {"count": "10"}, "expect": [10000, 40001]},
    {"name": "代理IP-91HTTP", "method": "GET", "path": "/api/ProxyIp/91http/proxies",
     "params": {"num": "10"}, "expect": [10000, 40001]},
    {"name": "代理IP-青雨", "method": "GET", "path": "/api/ProxyIp/qy/proxies",
     "params": {"num": "1"}, "expect": [10000, 40001]},
    {"name": "代理IP-青雨-凭据未成对", "method": "GET", "path": "/api/ProxyIp/qy/proxies",
     "params": {"order": "000000000000000000"}, "expect": [20001]},
    {"name": "代理IP-青雨-自定义凭据(占位)", "method": "GET", "path": "/api/ProxyIp/qy/proxies",
     "params": {"num": "1", "order": "000000000000000000", "apikey": "00000000000000000000000000000000"},
     "expect": [40001]},
    {"name": "代理IP-青雨住宅长效", "method": "GET", "path": "/api/ProxyIp/qy_res/proxies",
     "params": {"verify": "false"}, "expect": [10000, 40001]},
    {"name": "代理IP-青雨住宅长效-内网host被拒", "method": "GET", "path": "/api/ProxyIp/qy_res/proxies",
     "params": {"host": "127.0.0.1", "port": "6379", "verify": "true"}, "expect": [20003]},
